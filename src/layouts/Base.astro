---
import { pageUrl, withBase } from '../lib/base';

/** Page shell. `title` and `description` come from the hero content, so they cannot drift from it. */
interface Props {
	title: string;
	description: string;
	/** Hero title on its own, without the acronym: what a share card names as the site. */
	siteName: string;
	/** Alternative text of `public/og.png`, for consumers that show it. */
	imageAlt: string;
	/** Visible text of the skip link. */
	skipLabel: string;
	/** Schema.org graph, built in `index.astro` from the same content the page renders. */
	jsonLd: unknown;
}

const { title, description, siteName, imageAlt, skipLabel, jsonLd } = Astro.props;
const canonical = pageUrl(Astro.site);
// Absolute, because every consumer of og:image fetches it without a document to resolve against.
const shareImage = new URL(withBase('/og.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{/* The plain-text mirror, findable without fetching the body. */}
		<link rel="alternate" type="text/plain" href={withBase('/llms.txt')} title="llms.txt" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={siteName} />
		{/* Generated once and committed, per docs/art-direction.md: the title never changes. */}
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{/* Same value as `--bg`, so the browser chrome carries the page's ground. */}
		<meta name="theme-color" content="#07160f" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		{/* Raster copies of the same mark, for Safari < 16.4 and for "add to home screen". */}
		<link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
		<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Montserrat:wght@600;700&family=Source+Sans+3:wght@400&display=swap"
		/>
		{/* `is:inline` because this is data, not code: it must ship verbatim, unbundled. `set:html`
		    writes the string raw, so any `<` in the content would be free to close the script early. */}
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
		/>
	</head>
	<body>
		<a class="skip" href="#content">{skipLabel}</a>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;

		/* One palette: a deep forest green-black ground, VirtusLab's bright green carrying text, links
		   and fills, and one amber, used sparingly, marking the eyes and the paid block. */
		--bg: #07160f;
		--surface: #0f2418;
		/* Lighter than --surface: on the forest ground a band reads as a surface by rising out of the
		   card, not by sinking into it. It is the card's footer band, and the same band under a
		   pointer; both carry --muted and --accent text, so neither may go darker than this. */
		--surface-2: #14301f;
		--surface-2-hover: #1b3f29;
		--fg: #eaf4ea;
		--muted: #a7c1ae;
		--accent: #67e387;
		/* The brand green as printed; used for rules, fills and the artwork, never as text. */
		--accent-bright: #00c859;
		/* On the forest ground the amber already clears 4.5:1, so text and fill share one value. */
		--accent-2: #f0b756;
		--accent-2-text: #f0b756;
		/* Text drawn on top of a solid --accent fill, and on a solid --accent-2 one. */
		--on-accent: #07160f;
		--on-accent-2: #07160f;
		/* Hairlines. Never text: --line separates, --line-strong outlines the thing being looked at. */
		--line: #22402e;
		--line-strong: #2f5a40;

		/* The artwork carries no tokens: it is transparent rendered PNGs in `public/art/`, with their
		   own colours baked in. See docs/art-direction.md. */

		/* Background of the code panel: github-dark-high-contrast on a forest black of our own, so
		   the panel joins the palette and reads as a surface without an outline doing the work. */
		--code-bg: #041009;

		--font-display: 'Montserrat', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		--font-body: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;

		/* 1.25 above the base; the two steps below it are fixed, a ratio would make them illegible. */
		--text-xs: 0.75rem;
		--text-sm: 0.875rem;
		--text-base: 1rem;
		--text-lg: 1.25rem;
		--text-xl: 1.5625rem;
		--text-2xl: 1.953rem;
		/* Monospace runs wide, so code sits below the prose scale. Same size at every width: on a
		   phone the snippet is the point of the page, and a smaller size only makes it harder. */
		--text-code: 0.8125rem;

		/* Cap for running text; the page container is wider to hold the two-column grid. */
		--measure: 65ch;
		--page-width: 62rem;
		/* Height of the floating chapter picker; anchors scroll clear of it. */
		--float-nav-height: 3.25rem;
		/* Section-icon tile, the card's link icons, and the mark in the code panel's title bar. The
		   icons ship at 128px, twice the tile, so they stay crisp on a 2x screen. */
		--icon: 64px;
		--icon-sm: 20px;
		--mark: 22px;

		--border: 1px;
		--border-thick: 2px;
		/* The bright-green underline motif: thick enough to read as a mark, not as a border. */
		--rule: 3px;

		--space-1: 4px;
		--space-2: 8px;
		--space-3: 16px;
		--space-4: 28px;
		--space-5: 48px;
		--space-6: 72px;

		/* One soft shadow, and the same shadow lifted; nothing on the page casts a third. */
		--radius-sm: 8px;
		--radius: 14px;
		/* The code panel only: the one surface big enough to carry a larger corner. */
		--radius-lg: 26px;
		--radius-pill: 999px;
		--shadow-soft:
			0 1px 2px rgb(0 0 0 / 0.4),
			0 8px 22px rgb(0 0 0 / 0.45);
		--shadow-lift:
			0 2px 6px rgb(0 0 0 / 0.45),
			0 18px 40px rgb(0 0 0 / 0.55);

		/* Two washes over the forest ground: the page has weather, not a grid. Placed and sized in
		   pixels — a percentage offset resolves against the whole page height, which pushes both
		   washes far below the only screen they were meant to tint. */
		--ground:
			radial-gradient(940px 640px at 14% 60px, rgb(0 200 89 / 0.13), transparent 70%),
			radial-gradient(780px 540px at 94% 190px, rgb(240 183 86 / 0.09), transparent 68%);
	}

	* {
		box-sizing: border-box;
	}

	/* The floating picker covers the top edge at every width, so no anchor may land underneath it. */
	html {
		scroll-padding-top: calc(var(--float-nav-height) + var(--space-3));
	}

	body {
		margin: 0;
		background-color: var(--bg);
		background-image: var(--ground);
		background-repeat: no-repeat;
		color: var(--fg);
		font-family: var(--font-body);
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	a:hover {
		text-decoration-thickness: var(--border-thick);
	}

	/* No radius here: the outline follows whatever shape the focused element already has, and forcing
	   one on every element squared off the pill-shaped nav links and tabs. */
	:focus-visible {
		outline: var(--border-thick) solid var(--accent-2-text);
		outline-offset: var(--border-thick);
	}

	/* The first focusable on the page, parked above the top edge until it takes focus. Fixed, not
	   absolute, so it is on screen wherever the reader has scrolled to; `z-index: 2` clears the
	   floating nav, which is 1. */
	.skip {
		position: fixed;
		left: var(--space-3);
		top: calc(var(--space-3) * -4);
		z-index: 2;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-pill);
		background: var(--accent);
		color: var(--on-accent);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 700;
		text-decoration: none;
		transition: top 0.15s ease;
	}

	.skip:focus-visible {
		top: var(--space-3);
	}

	/* Every surface on the page: a hairline, a soft shadow and the shared radius. Components override
	   the background and the border colour; only the card and the CTA lift on hover. */
	.panel {
		border: var(--border) solid var(--line);
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.015em;
	}

	h1 {
		letter-spacing: -0.03em;
	}

	h3 {
		font-weight: 600;
		letter-spacing: -0.005em;
	}

	/* The heading that opens a chapter: the snippets, the benefits, and each component section. One
	   rule, so all three start at the same size and on the same rhythm. */
	.chapter-heading {
		margin: 0 0 var(--space-3);
		font-size: var(--text-xl);
	}

	p {
		max-width: var(--measure);
	}

	/* Inline code only; the snippet blocks size themselves. JetBrains Mono has a taller x-height and
	   wider glyphs than Source Sans, so at the prose size it looks a step too big next to it. */
	:not(pre) > code {
		font-family: var(--font-mono);
		font-size: 0.875em;
	}

	@media (min-width: 720px) {
		:root {
			/* One step further up the scale: the hero only has room to be larger on the wide layout. */
			--text-2xl: 2.441rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.skip {
			transition: none;
		}
	}
</style>
