---
import { pageUrl, withBase } from '../lib/base';

/** Page shell. `title` and `description` come from the hero content, so they cannot drift from it. */
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = pageUrl(Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{/* No og:image: there is no artwork for the page, and a bad one is worse than none. */}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Newsreader:opsz,wght@6..72,500&family=Source+Sans+3:wght@400;600&display=swap"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;

		/* Warm paper and green-black ink; the accent is the only saturated colour on the page. */
		--bg: #f8f7f2;
		--fg: #1b2422;
		--muted: #56615d;
		--accent: #0c6355;
		/* Text drawn on top of a solid --accent fill (the one CTA). */
		--on-accent: #f8f7f2;
		--border: #ddd9cd;
		--tint: #eeece2;

		--font-display: 'Newsreader', Georgia, 'Times New Roman', serif;
		--font-body: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;

		/* 1.25 above the base; the two steps below it are fixed, a ratio would make them illegible. */
		--text-xs: 0.75rem;
		--text-sm: 0.875rem;
		--text-base: 1rem;
		--text-lg: 1.25rem;
		--text-xl: 1.5625rem;
		--text-2xl: 1.953rem;
		/* Monospace runs wide, so code sits below the prose scale. Same size at every width: on a
		   phone the snippet is the point of the page, and a smaller size only makes it harder. */
		--text-code: 0.8125rem;

		/* Cap for running text; the page container is wider to hold the two-column grid. */
		--measure: 65ch;
		--page-width: 58rem;
		/* Height of the sticky nav row; anchors scroll clear of it. */
		--nav-height: 3rem;
		--radius: 4px;
		/* The accent rule that marks a section heading and the active snippet tab. */
		--rule: var(--space-4);
		--rule-width: 2px;

		--space-1: 0.25rem;
		--space-2: 0.5rem;
		--space-3: 1rem;
		--space-4: 1.75rem;
		--space-5: 3rem;
		--space-6: 4rem;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			/* Not an inversion: the dark ground keeps the green cast, the accent lifts to a mint. */
			--bg: #121614;
			--fg: #e4e8e2;
			--muted: #98a39d;
			--accent: #74cfb9;
			--on-accent: #0c1211;
			--border: #2a322f;
			--tint: #1a201e;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--font-body);
		line-height: 1.6;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	h1,
	h2,
	h3 {
		line-height: 1.2;
	}

	h1,
	h2 {
		font-family: var(--font-display);
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	h3 {
		font-weight: 600;
	}

	p {
		max-width: var(--measure);
	}

	@media (min-width: 720px) {
		:root {
			/* One step further up the scale: the hero only has room to be large on the wide layout. */
			--text-2xl: 2.441rem;
		}

		/* The nav is sticky at this width, so an anchor must not land underneath it. */
		html {
			scroll-padding-top: var(--nav-height);
		}
	}
</style>
