---
import { pageUrl, withBase } from '../lib/base';

/** Page shell. `title` and `description` come from the hero content, so they cannot drift from it. */
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = pageUrl(Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{/* No og:image: the hero art is inline SVG, and a raster export would be a second source of truth. */}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Silkscreen:wght@400;700&family=Source+Sans+3:wght@400;600&display=swap"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;

		/* The pixel grid unit. Every border, offset, radius and spacing step below is a multiple of
		   it, so nothing on the page can land off the grid. */
		--px: 4px;

		/* Lilac paper, indigo ink, and a three-accent arcade set: violet leads, gold marks the
		   active thing, teal carries the graphics. */
		--bg: #f4f1fa;
		--tint: #e8e3f4;
		--fg: #1a1433;
		--muted: #4d4468;
		--accent: #5a2fbe;
		/* Gold is a fill, not an ink: bright enough to read as gold, too bright to sit on the page
		   ground as text. --accent-2-text is the same gold taken down until it clears 4.5:1 there. */
		--accent-2: #e0a020;
		--accent-2-text: #8a5000;
		--accent-3: #0a6a66;
		/* Text drawn on top of a solid --accent or --accent-3 fill, and on a solid --accent-2 one. */
		--on-accent: #f4f1fa;
		--on-accent-2: #1a1433;
		/* Chunky outline around every raised box. Dark in light mode: pixel art is drawn outline-first. */
		--line: #2b2350;
		/* The two steps of the hard drop shadow: the near one strong, the far one fading out. */
		--shadow: #2b2350;
		--shadow-far: #b3a6d6;
		/* Inner bevel of a pressed box: shaded top-left, lit bottom-right. Both are shades of the
		   accent the bevel is drawn on, since only the checked tab is pressed. */
		--bevel-shade: #3a1c80;
		--bevel-light: #8a67d8;
		/* Fill-only colours for the SVG graphics; never used for text. */
		--px-ink: #1a1433;
		--px-sky: #ded4f4;
		--px-cloud: #ffffff;
		--px-1: #5a2fbe;
		--px-2: #e0a020;
		--px-3: #17a394;
		/* Background of the code panel; the light Shiki theme's own white would not read as a panel. */
		--code-bg: #e8e3f4;

		--font-display: 'Silkscreen', 'Courier New', ui-monospace, monospace;
		--font-body: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;

		/* 1.25 above the base; the two steps below it are fixed, a ratio would make them illegible. */
		--text-xs: 0.75rem;
		--text-sm: 0.875rem;
		--text-base: 1rem;
		--text-lg: 1.25rem;
		--text-xl: 1.5625rem;
		--text-2xl: 1.953rem;
		/* Monospace runs wide, so code sits below the prose scale. Same size at every width: on a
		   phone the snippet is the point of the page, and a smaller size only makes it harder. */
		--text-code: 0.8125rem;

		/* Cap for running text; the page container is wider to hold the two-column grid. */
		--measure: 65ch;
		--page-width: 60rem;
		/* Height of the sticky nav row; anchors scroll clear of it. */
		--nav-height: 3.5rem;

		/* Chunky outline, the half-unit rule used where an outline would be too loud, and the
		   single-pixel line the page's own grid is drawn with. */
		--edge: var(--px);
		--hair: calc(var(--px) / 2);
		--grid-line: 1px;

		--space-1: calc(var(--px) * 1);
		--space-2: calc(var(--px) * 2);
		--space-3: calc(var(--px) * 4);
		--space-4: calc(var(--px) * 7);
		--space-5: calc(var(--px) * 12);
		--space-6: calc(var(--px) * 16);

		/* One hard step, then a second lighter one: a drawn shadow, not a blurred one. */
		--shadow-step:
			var(--px) var(--px) 0 0 var(--shadow),
			calc(var(--px) * 2) calc(var(--px) * 2) 0 0 var(--shadow-far);
		/* The same shadow collapsed to its first step, for a box that is pressed in. */
		--shadow-flat: var(--px) var(--px) 0 0 var(--shadow);
		/* Pressed: shaded top-left, lit bottom-right, the opposite of the raised boxes the drop
		   shadow makes. Drawn inside the box, so pressing does not shift layout. */
		--bevel:
			inset var(--px) var(--px) 0 0 var(--bevel-shade),
			inset calc(var(--px) * -1) calc(var(--px) * -1) 0 0 var(--bevel-light);
	}

	@media (prefers-color-scheme: dark) {
		:root {
			/* Not an inversion: the ground becomes a night sky, the outline flips to a lit violet,
			   and the accents brighten to arcade phosphor rather than staying the same hues. */
			--bg: #141120;
			--tint: #1e1934;
			--fg: #ece8fa;
			--muted: #a79dc6;
			--accent: #b39aff;
			--accent-2: #f0c04f;
			/* On the night ground the bright gold already clears 4.5:1, so text and fill agree. */
			--accent-2-text: #f0c04f;
			--accent-3: #57d7c3;
			--on-accent: #141120;
			--on-accent-2: #141120;
			--line: #4a3f78;
			/* Both steps are lighter than the ground: a shadow darker than a night sky is invisible,
			   so here the drawn shadow is a lit rim that fades with distance, as it does in light mode. */
			--shadow: #4a3f78;
			--shadow-far: #3a3160;
			--bevel-shade: #7d63d6;
			--bevel-light: #d8cbff;
			--px-ink: #0a0814;
			--px-sky: #221c3a;
			--px-cloud: #362e58;
			--px-1: #a98cff;
			--px-2: #f5c451;
			--px-3: #4fd6c2;
			/* github-dark-high-contrast on a violet-black of our own, so the panel joins the palette. */
			--code-bg: #0d0b16;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--font-body);
		line-height: 1.6;
		/* The page ground is a faint pixel grid: two hairlines repeating on the grid unit. */
		background-image:
			linear-gradient(to right, var(--tint) var(--grid-line), transparent var(--grid-line)),
			linear-gradient(to bottom, var(--tint) var(--grid-line), transparent var(--grid-line));
		background-size: calc(var(--px) * 8) calc(var(--px) * 8);
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.18em;
		text-decoration-thickness: var(--hair);
	}

	/* Gold, the one colour used nowhere else as a line on the page ground, at the weight that
	   clears 4.5:1 there. */
	:focus-visible {
		outline: var(--hair) solid var(--accent-2-text);
		outline-offset: var(--hair);
	}

	/* Every raised box on the page: chunky outline, two hard shadow steps. Components override the
	   background, the border colour, and the number of steps. */
	.pixel-box {
		border: var(--edge) solid var(--line);
		box-shadow: var(--shadow-step);
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		font-weight: 400;
		/* A pixel face sits tight in its em box, so headings need more leading than a serif would. */
		line-height: 1.45;
		letter-spacing: 0;
	}

	h1,
	h2 {
		font-weight: 700;
	}

	p {
		max-width: var(--measure);
	}

	code {
		font-family: var(--font-mono);
	}

	@media (min-width: 720px) {
		:root {
			/* One step further up the scale: the hero only has room to be large on the wide layout. */
			--text-2xl: 2.441rem;
		}

		/* The nav is sticky at this width, so an anchor must not land underneath it. */
		html {
			scroll-padding-top: calc(var(--nav-height) + var(--space-3));
		}
	}
</style>
