---
import { pageUrl, withBase } from '../lib/base';

/** Page shell. `title` and `description` come from the hero content, so they cannot drift from it. */
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = pageUrl(Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{/* No og:image: the hero art is inline SVG, and a raster export would be a second source of truth. */}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Montserrat:wght@600;700&family=Source+Sans+3:wght@400&display=swap"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;

		/* Warm paper, green-black ink, and VirtusLab's greens: a saturated green carries text and
		   links, the bright one is a fill only, and one amber marks the eyes and the paid block. */
		--bg: #f9f6f5;
		--surface: #eef3e7;
		--fg: #16211a;
		--muted: #4a5b50;
		--accent: #046b39;
		/* Too bright to read as text on the warm ground; used for fills, rules and the artwork. */
		--accent-bright: #00c859;
		/* Amber is a fill, not an ink. --accent-2-text is the same amber taken down until it clears
		   4.5:1 on both grounds. */
		--accent-2: #e2a02c;
		--accent-2-text: #8a4a00;
		/* Text drawn on top of a solid --accent fill, and on a solid --accent-2 one. */
		--on-accent: #f9f6f5;
		--on-accent-2: #16211a;
		/* Hairlines. Never text: --line separates, --line-strong outlines the thing being looked at. */
		--line: #dbe3d3;
		--line-strong: #bed0b2;

		/* Fill-only colours for the frog artwork; never used for text. The frog ramp is the VL green
		   scale, so the illustration and the interface are the same palette. */
		--art-ink: #10241a;
		--art-frog-dark: #00693a;
		--art-frog: #00a74e;
		--art-frog-light: #67e387;
		--art-belly: #d5f3c2;
		--art-leaf: #007c3e;
		--art-leaf-light: #00c859;
		--art-disc: #e5f7de;
		--art-disc-core: #f4fcee;
		--art-disc-edge: #b4f5b5;
		--art-eye: #f0a828;
		--art-eye-dark: #b06f0c;
		--art-shine: #ffffff;

		/* Background of the code panel: a hair greener and darker than the page, so the panel reads
		   as a surface without an outline doing the work. */
		--code-bg: #f2f5ec;

		--font-display: 'Montserrat', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		--font-body: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;

		/* 1.25 above the base; the two steps below it are fixed, a ratio would make them illegible. */
		--text-xs: 0.75rem;
		--text-sm: 0.875rem;
		--text-base: 1rem;
		--text-lg: 1.25rem;
		--text-xl: 1.5625rem;
		--text-2xl: 1.953rem;
		/* Monospace runs wide, so code sits below the prose scale. Same size at every width: on a
		   phone the snippet is the point of the page, and a smaller size only makes it harder. */
		--text-code: 0.8125rem;

		/* Cap for running text; the page container is wider to hold the two-column grid. */
		--measure: 65ch;
		--page-width: 62rem;
		/* Height of the sticky nav row; anchors scroll clear of it. */
		--nav-height: 3.75rem;
		/* Section-icon tile, the frog mark in the code panel's title bar, and the one figure-sized
		   illustration outside the hero. */
		--icon: 48px;
		--mark: 22px;
		--figure: 120px;

		--border: 1px;
		--border-thick: 2px;
		/* The bright-green underline motif: thick enough to read as a mark, not as a border. */
		--rule: 3px;

		--space-1: 4px;
		--space-2: 8px;
		--space-3: 16px;
		--space-4: 28px;
		--space-5: 48px;
		--space-6: 72px;

		/* One soft shadow, and the same shadow lifted; nothing on the page casts a third. */
		--radius-sm: 8px;
		--radius: 14px;
		/* The code panel only: the one surface big enough to carry a larger corner. */
		--radius-lg: 26px;
		--radius-pill: 999px;
		--shadow-soft:
			0 1px 2px rgb(16 36 26 / 0.05),
			0 8px 22px rgb(16 36 26 / 0.07);
		--shadow-lift:
			0 2px 6px rgb(16 36 26 / 0.07),
			0 18px 40px rgb(16 36 26 / 0.12);

		/* Two washes over the warm ground: the page has weather, not a grid. Placed and sized in
		   pixels — a percentage offset resolves against the whole page height, which pushes both
		   washes far below the only screen they were meant to tint. */
		--ground:
			radial-gradient(940px 640px at 14% 60px, rgb(0 200 89 / 0.13), transparent 70%),
			radial-gradient(780px 540px at 94% 190px, rgb(226 160 44 / 0.11), transparent 68%);
	}

	@media (prefers-color-scheme: dark) {
		:root {
			/* Not an inversion: the ground becomes a deep forest green-black and the greens brighten,
			   so the accent that was fill-only in light mode becomes the one that carries text. */
			--bg: #07160f;
			--surface: #0f2418;
			--fg: #eaf4ea;
			--muted: #a7c1ae;
			--accent: #67e387;
			--accent-bright: #00c859;
			--accent-2: #f0b756;
			/* On the forest ground the bright amber already clears 4.5:1, so text and fill agree. */
			--accent-2-text: #f0b756;
			--on-accent: #07160f;
			--on-accent-2: #07160f;
			--line: #22402e;
			--line-strong: #2f5a40;

			--art-ink: #04100b;
			--art-frog-dark: #007c3e;
			--art-frog: #00c859;
			--art-frog-light: #b4f5b5;
			--art-belly: #d5f3c2;
			--art-leaf: #00a74e;
			--art-leaf-light: #67e387;
			--art-disc: #0d2a1b;
			--art-disc-core: #123723;
			--art-disc-edge: #1d4a30;
			--art-eye: #f7c15c;
			--art-eye-dark: #c07d16;
			--art-shine: #f9f6f5;

			/* github-dark-high-contrast on a forest black of our own, so the panel joins the palette. */
			--code-bg: #041009;

			--shadow-soft:
				0 1px 2px rgb(0 0 0 / 0.4),
				0 8px 22px rgb(0 0 0 / 0.45);
			--shadow-lift:
				0 2px 6px rgb(0 0 0 / 0.45),
				0 18px 40px rgb(0 0 0 / 0.55);

			--ground:
				radial-gradient(940px 640px at 14% 60px, rgb(0 200 89 / 0.13), transparent 70%),
				radial-gradient(780px 540px at 94% 190px, rgb(240 183 86 / 0.09), transparent 68%);
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background-color: var(--bg);
		background-image: var(--ground);
		background-repeat: no-repeat;
		color: var(--fg);
		font-family: var(--font-body);
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	a:hover {
		text-decoration-thickness: var(--border-thick);
	}

	/* No radius here: the outline follows whatever shape the focused element already has, and forcing
	   one on every element squared off the pill-shaped nav links and tabs. */
	:focus-visible {
		outline: var(--border-thick) solid var(--accent-2-text);
		outline-offset: var(--border-thick);
	}

	/* Every surface on the page: a hairline, a soft shadow and the shared radius. Components override
	   the background and the border colour; only the card and the CTA lift on hover. */
	.panel {
		border: var(--border) solid var(--line);
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.015em;
	}

	h1 {
		letter-spacing: -0.03em;
	}

	h3 {
		font-weight: 600;
		letter-spacing: -0.005em;
	}

	p {
		max-width: var(--measure);
	}

	code {
		font-family: var(--font-mono);
	}

	@media (min-width: 720px) {
		:root {
			/* Two steps further up the scale: the hero only has room to be large on the wide layout. */
			--text-2xl: 3.052rem;
		}

		/* The nav is sticky at this width, so an anchor must not land underneath it. */
		html {
			scroll-padding-top: calc(var(--nav-height) + var(--space-3));
		}
	}
</style>
