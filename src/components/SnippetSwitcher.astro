---
import { Code } from 'astro:components';
import CodeBar from './graphics/CodeBar.astro';

/**
 * CSS-only tabbed snippets: one radio per tab, all panels always in the DOM, stacked in a single
 * grid cell so switching never changes the page height. No client-side JavaScript.
 */
interface Props {
	tabs: {
		id: string;
		label: string;
		code: string;
		componentId: string;
		componentName: string;
		fullExampleHref: string;
	}[];
	fullExampleLabel: string;
	legend: string;
}

const { tabs, fullExampleLabel, legend } = Astro.props;

const radioId = (id: string) => `snippet-${id}`;
const panelId = (id: string) => `panel-${id}`;

// One rule set per tab, generated so that adding a snippet to the YAML needs no CSS change. The
// selectors need the concrete ids, which only exist here.
const tabRules = tabs
	.map(
		(tab) => `
#${radioId(tab.id)}:checked ~ .tabs label[for="${radioId(tab.id)}"] {
	background: var(--accent);
	color: var(--on-accent);
	box-shadow: var(--bevel);
	transform: translate(var(--px), var(--px));
}
#${radioId(tab.id)}:focus-visible ~ .tabs label[for="${radioId(tab.id)}"] {
	outline: var(--hair) solid var(--accent-2-text);
	outline-offset: var(--hair);
}
#${radioId(tab.id)}:checked ~ .panels #${panelId(tab.id)} {
	visibility: visible;
}`,
	)
	.join('\n');
---

<div class="switcher">
	<fieldset>
		<legend>{legend}</legend>
		{
			tabs.map((tab, i) => (
				<input
					class="radio"
					type="radio"
					name="snippet"
					id={radioId(tab.id)}
					checked={i === 0}
				/>
			))
		}
		<div class="tabs">
			{tabs.map((tab) => <label class="pixel-box" for={radioId(tab.id)}>{tab.label}</label>)}
		</div>
		{/* Inside the fieldset, so every panel stays a sibling of the radios that switch it. */}
		<div class="panels">
			{
				tabs.map((tab) => (
					<div class="panel" id={panelId(tab.id)}>
						<div class="frame pixel-box">
							<div class="bar">
								<CodeBar />
							</div>
							<div class="code">
								<Code
									code={tab.code}
									lang="scala"
									themes={{ light: 'github-light-high-contrast', dark: 'github-dark-high-contrast' }}
									defaultColor={false}
								/>
							</div>
						</div>
						<p class="panel-links">
							<a href={`#${tab.componentId}`}>{tab.componentName}</a>
							<a href={tab.fullExampleHref}>{fullExampleLabel}</a>
						</p>
					</div>
				))
			}
		</div>
	</fieldset>
</div>

{/* Global CSS, not scoped: the rules are anchored on the unique `#snippet-*` / `#panel-*` ids. */}
<style is:inline set:html={tabRules}></style>

<style>
	.switcher {
		position: relative;
		margin: var(--space-5) 0;
	}

	/* Groups the radios for screen readers; every default box of a fieldset is unwanted here. */
	fieldset {
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}

	legend {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Visually hidden but focusable, so the native arrow-key switching of a radio group still works. */
	.radio {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		border: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Tracks fit themselves to the width: two rows of two on a phone, one row of four on a desktop.
	   The gap leaves room for each key's hard shadow. */
	.tabs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: var(--space-2) var(--space-3);
		margin-bottom: var(--space-3);
	}

	/* Every tab is a raised key, one step off the board; the rules above press the checked one in. */
	.tabs label {
		padding: var(--space-2);
		background: var(--tint);
		box-shadow: var(--shadow-flat);
		color: var(--fg);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		line-height: 1.5;
		text-align: center;
		cursor: pointer;
	}

	.tabs label:hover {
		background: var(--accent-3);
		color: var(--on-accent);
	}

	/* All panels share one grid cell, so the box is as tall as the tallest snippet and never jumps. */
	.panels {
		display: grid;
	}

	.panel {
		grid-area: 1 / 1;
		/* Without this a wide snippet stretches the grid cell instead of scrolling inside the panel. */
		min-width: 0;
		visibility: hidden;
	}

	/* The pixel frame around the code; outline and shadow come from `.pixel-box`. */
	.frame {
		background: var(--code-bg);
	}

	.bar {
		display: flex;
		align-items: center;
		padding: var(--space-2);
		border-bottom: var(--edge) solid var(--line);
		background: var(--bg);
	}

	.code {
		position: relative;
	}

	/* Hint that the code scrolls sideways: a fade over the right edge of the code box, phones only,
	   where the snippet is always wider than the screen and the thin scrollbar is easy to miss.
	   Positioned, so it paints over the code text and not only over the box background. */
	.code::after {
		content: '';
		position: absolute;
		inset: 0 0 0 auto;
		/* Short and steep, so it reads as "the line carries on" and not as a soft vignette. */
		width: calc(var(--px) * 6);
		background: linear-gradient(to right, transparent, var(--code-bg) 60%);
		pointer-events: none;
	}

	.panel-links {
		display: flex;
		gap: var(--space-4);
		margin: var(--space-3) 0 0;
		font-family: var(--font-display);
		font-size: var(--text-xs);
	}

	/* Shiki renders both themes as CSS variables (defaultColor: false); pick one per color scheme.
	   The panel background is our own token in both modes, so it belongs to the palette. */
	.panel :global(pre.astro-code) {
		margin: 0;
		padding: var(--space-3);
		font-family: var(--font-mono);
		font-size: var(--text-code);
		line-height: 1.6;
		overflow-x: auto;
		scrollbar-width: thin;
		color: var(--shiki-light);
		background-color: var(--code-bg);
	}

	.panel :global(pre.astro-code span) {
		color: var(--shiki-light);
	}

	@media (prefers-color-scheme: dark) {
		.panel :global(pre.astro-code) {
			color: var(--shiki-dark);
		}

		.panel :global(pre.astro-code span) {
			color: var(--shiki-dark);
		}
	}

	@media (min-width: 720px) {
		.code::after {
			display: none;
		}
	}
</style>
