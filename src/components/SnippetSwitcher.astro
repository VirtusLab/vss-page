---
import { Code } from 'astro:components';
import CodeBar from './graphics/CodeBar.astro';

/**
 * CSS-only tabbed snippets: one radio per tab, all panels always in the DOM, stacked in a single
 * grid cell so switching never changes the page height. No client-side JavaScript.
 */
interface Props {
	tabs: {
		id: string;
		label: string;
		code: string;
		componentId: string;
		componentName: string;
		fullExampleHref: string;
	}[];
	fullExampleLabel: string;
	legend: string;
	heading: string;
	/** One sentence containing `command` verbatim, which is rendered as inline code. */
	note: string;
	command: string;
}

const { tabs, fullExampleLabel, legend, heading, note, command } = Astro.props;

// Splitting keeps the whole sentence in the content file while the command still gets its own
// element. The labels schema guarantees the command is in there.
const [noteBefore, noteAfter] = note.split(command);

const radioId = (id: string) => `snippet-${id}`;
const panelId = (id: string) => `panel-${id}`;

// One rule set per tab, generated so that adding a snippet to the YAML needs no CSS change. The
// selectors need the concrete ids, which only exist here.
const tabRules = tabs
	.map(
		(tab) => `
#${radioId(tab.id)}:checked ~ .tabs label[for="${radioId(tab.id)}"] {
	background: var(--accent);
	border-color: var(--accent);
	color: var(--on-accent);
	box-shadow: var(--shadow-soft);
}
#${radioId(tab.id)}:focus-visible ~ .tabs label[for="${radioId(tab.id)}"] {
	outline: var(--border-thick) solid var(--accent-2-text);
	outline-offset: var(--border-thick);
}
#${radioId(tab.id)}:checked ~ .panels #${panelId(tab.id)} {
	visibility: visible;
}`,
	)
	.join('\n');
---

<div class="switcher">
	<h2>{heading}</h2>
	{/* Kept on one line: the build drops a whitespace-only text node between two tags. */}
	<p class="note">{noteBefore}<code>{command}</code>{noteAfter}</p>
	<fieldset>
		<legend>{legend}</legend>
		{
			tabs.map((tab, i) => (
				<input
					class="radio"
					type="radio"
					name="snippet"
					id={radioId(tab.id)}
					checked={i === 0}
				/>
			))
		}
		<div class="tabs">
			{tabs.map((tab) => <label for={radioId(tab.id)}>{tab.label}</label>)}
		</div>
		{/* Inside the fieldset, so every panel stays a sibling of the radios that switch it. */}
		<div class="panels">
			{
				tabs.map((tab) => (
					<div class="snippet-panel" id={panelId(tab.id)}>
						<div class="frame panel">
							<div class="bar">
								<CodeBar />
							</div>
							<div class="code">
								<Code
									code={tab.code}
									lang="scala"
									themes={{ light: 'github-light-high-contrast', dark: 'github-dark-high-contrast' }}
									defaultColor={false}
								/>
							</div>
						</div>
						<p class="panel-links">
							<a href={`#${tab.componentId}`}>{tab.componentName}</a>
							<a href={tab.fullExampleHref}>{fullExampleLabel}</a>
						</p>
					</div>
				))
			}
		</div>
	</fieldset>
</div>

{/* Global CSS, not scoped: the rules are anchored on the unique `#snippet-*` / `#panel-*` ids. */}
<style is:inline set:html={tabRules}></style>

<style>
	.switcher {
		position: relative;
		margin: var(--space-5) 0;
	}

	/* No icon: the frog mark already sits in the panel's title bar, one line below. */
	h2 {
		margin: 0 0 var(--space-2);
		font-size: var(--text-xl);
	}

	.note {
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		color: var(--muted);
	}

	.note code {
		font-size: var(--text-code);
	}

	/* Groups the radios for screen readers; every default box of a fieldset is unwanted here. */
	fieldset {
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}

	legend {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Visually hidden but focusable, so the native arrow-key switching of a radio group still works. */
	.radio {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		border: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Two per row on a phone, four per row on a desktop (the count is set in the media query at the
	   bottom). Fixed counts, not `auto-fit`: that packs in as many as fit at the current width, which
	   with eight tabs left a short last row. */
	.tabs {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-2);
		margin-bottom: var(--space-3);
	}

	/* Every tab is an outlined pill; the rules above fill the checked one with green. */
	.tabs label {
		padding: var(--space-2) var(--space-3);
		border: var(--border) solid var(--line-strong);
		border-radius: var(--radius-pill);
		background: var(--surface);
		color: var(--fg);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 600;
		line-height: 1.5;
		text-align: center;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.tabs label:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* All panels share one grid cell, so the box is as tall as the tallest snippet and never jumps. */
	.panels {
		display: grid;
	}

	/* Not `.panel`: that is the global surface utility, and sharing the name put a second hairline
	   and a card outline around every panel, links included. */
	.snippet-panel {
		grid-area: 1 / 1;
		/* Without this a wide snippet stretches the grid cell instead of scrolling inside the panel. */
		min-width: 0;
		visibility: hidden;
	}

	/* The code panel is the hero content: the one surface on the lifted shadow and the large radius.
	   Hairline and base radius come from `.panel`. */
	.frame {
		background: var(--code-bg);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lift);
		overflow: hidden;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		border-bottom: var(--border) solid var(--line);
		background: var(--surface);
	}

	.code {
		position: relative;
	}

	/* Hint that the code scrolls sideways: a fade over the right edge of the code box, phones only,
	   where the snippet is always wider than the screen and the thin scrollbar is easy to miss.
	   Positioned, so it paints over the code text and not only over the box background. */
	.code::after {
		content: '';
		position: absolute;
		inset: 0 0 0 auto;
		width: var(--space-4);
		background: linear-gradient(to right, transparent, var(--code-bg) 72%);
		pointer-events: none;
	}

	.panel-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		margin: var(--space-3) 0 0;
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 600;
	}

	/* Shiki renders both themes as CSS variables (defaultColor: false); pick one per color scheme.
	   The panel background is our own token in both modes, so it belongs to the palette. */
	.snippet-panel :global(pre.astro-code) {
		margin: 0;
		padding: var(--space-3);
		font-family: var(--font-mono);
		font-size: var(--text-code);
		line-height: 1.65;
		overflow-x: auto;
		scrollbar-width: thin;
		color: var(--shiki-light);
		background-color: var(--code-bg);
	}

	.snippet-panel :global(pre.astro-code span) {
		color: var(--shiki-light);
	}

	@media (prefers-color-scheme: dark) {
		.snippet-panel :global(pre.astro-code) {
			color: var(--shiki-dark);
		}

		.snippet-panel :global(pre.astro-code span) {
			color: var(--shiki-dark);
		}
	}

	@media (min-width: 720px) {
		.tabs {
			grid-template-columns: repeat(4, 1fr);
		}

		.code::after {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tabs label {
			transition: none;
		}
	}
</style>
