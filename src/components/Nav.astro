---
/**
 * The one navigation row, placed between the hero and the switcher. Section labels are the section
 * titles verbatim, so nav and headings cannot diverge. Sticky above the 720px breakpoint only.
 */
interface Props {
	sections: { id: string; title: string }[];
	repoLabel: string;
	repoUrl: string;
}

const { sections, repoLabel, repoUrl } = Astro.props;
---

<nav class="nav">
	<ul>
		{
			sections.map((section) => (
				<li>
					<a href={`#${section.id}`}>{section.title}</a>
				</li>
			))
		}
		<li><a href={repoUrl}>{repoLabel}</a></li>
	</ul>
</nav>

<style>
	/* The bar is opaque and bled into the container's gutters, so the sticky row hides whatever
	   scrolls under it edge to edge. */
	.nav {
		background: var(--tint);
		margin: 0 calc(var(--space-3) * -1);
		padding: var(--space-2) var(--space-3);
		border-top: var(--edge) solid var(--line);
		border-bottom: var(--edge) solid var(--line);
		font-family: var(--font-display);
		font-size: var(--text-xs);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Chrome, not content: each label is its own little key, lit only on hover and focus. */
	.nav a {
		display: block;
		padding: var(--space-2);
		border: var(--hair) solid transparent;
		color: var(--fg);
		text-decoration: none;
		text-transform: uppercase;
	}

	.nav a:hover {
		border-color: var(--line);
		background: var(--accent);
		color: var(--on-accent);
	}

	@media (min-width: 720px) {
		.nav {
			position: sticky;
			top: 0;
			z-index: 1;
			min-height: var(--nav-height);
			display: flex;
			align-items: center;
			box-shadow: 0 var(--px) 0 0 var(--shadow-far);
		}

		ul {
			flex: 1;
			align-items: center;
			gap: var(--space-1) var(--space-3);
		}
	}
</style>
