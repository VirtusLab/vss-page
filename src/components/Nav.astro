---
/**
 * The in-flow index of the components chapter, so it leads into the sections it links to. Section
 * labels are the section titles verbatim, so nav and headings cannot diverge. It does not follow the
 * reader: `FloatingNav` is what stays on screen once the hero is gone.
 */
interface Props {
	sections: { id: string; title: string }[];
	/** The benefits heading, so the first link and the block's own `<h2>` cannot diverge either. */
	benefitsLabel: string;
	repoLabel: string;
	repoUrl: string;
	/** Accessible name of the row; the page carries a second `<nav>`. Not shown. */
	label: string;
}

const { sections, benefitsLabel, repoLabel, repoUrl, label } = Astro.props;
---

<nav class="nav" aria-label={label}>
	{/* `list-style: none` drops list semantics in Safari/VoiceOver; the role puts them back. */}
	<ul role="list">
		{/* The benefits sit above the nav, not below it, but the row is the page's index: leaving
		    them out would be the one block a reader cannot jump back to. */}
		<li><a href="#benefits">{benefitsLabel}</a></li>
		{
			sections.map((section) => (
				<li>
					<a href={`#${section.id}`}>{section.title}</a>
				</li>
			))
		}
		<li><a href={repoUrl}>{repoLabel}</a></li>
	</ul>
</nav>

<style>
	/* Bled into the container's gutters, so the row's ground and its bottom hairline run the full
	   width of the column rather than stopping short of it. */
	.nav {
		background: var(--bg);
		/* The top margin is what keeps the row off the divider that closes the chapter above it. */
		margin: var(--space-5) calc(var(--space-3) * -1) 0;
		padding: var(--space-2) var(--space-3);
		border-bottom: var(--border) solid var(--line);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 600;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Chrome, not content: each label is a quiet pill that fills with green only on hover and focus. */
	.nav a {
		display: block;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-pill);
		color: var(--fg);
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.nav a:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	@media (min-width: 720px) {
		ul {
			align-items: center;
			gap: var(--space-1) var(--space-2);
		}
	}
</style>
