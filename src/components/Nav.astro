---
/**
 * The one navigation row, opening the components chapter, so it leads into the sections it links to.
 * Section labels are the section titles verbatim, so nav and headings cannot diverge. Sticky above
 * the 720px breakpoint only.
 */
interface Props {
	sections: { id: string; title: string }[];
	/** The benefits heading, so the first link and the block's own `<h2>` cannot diverge either. */
	benefitsLabel: string;
	repoLabel: string;
	repoUrl: string;
}

const { sections, benefitsLabel, repoLabel, repoUrl } = Astro.props;
---

<nav class="nav">
	<ul>
		{/* The benefits sit above the nav, not below it, but the row is the page's index: leaving
		    them out would be the one block a reader cannot jump back to. */}
		<li><a href="#benefits">{benefitsLabel}</a></li>
		{
			sections.map((section) => (
				<li>
					<a href={`#${section.id}`}>{section.title}</a>
				</li>
			))
		}
		<li><a href={repoUrl}>{repoLabel}</a></li>
	</ul>
</nav>

<style>
	/* The bar is opaque and bled into the container's gutters, so the sticky row hides whatever
	   scrolls under it edge to edge. */
	.nav {
		background: var(--bg);
		margin: 0 calc(var(--space-3) * -1);
		padding: var(--space-2) var(--space-3);
		border-bottom: var(--border) solid var(--line);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 600;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Chrome, not content: each label is a quiet pill that fills with green only on hover and focus. */
	.nav a {
		display: block;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-pill);
		color: var(--fg);
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.nav a:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	@media (min-width: 720px) {
		.nav {
			position: sticky;
			top: 0;
			z-index: 1;
			min-height: var(--nav-height);
			display: flex;
			align-items: center;
			/* Opaque enough to hide the page under it while the warm ground still shows through. */
			background: color-mix(in srgb, var(--bg) 88%, transparent);
			-webkit-backdrop-filter: blur(10px);
			backdrop-filter: blur(10px);
		}

		ul {
			flex: 1;
			align-items: center;
			gap: var(--space-1) var(--space-2);
		}
	}
</style>
