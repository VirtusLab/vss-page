---
/**
 * The one navigation row, placed between the hero and the switcher. Section labels are the section
 * titles verbatim, so nav and headings cannot diverge. Sticky above the 720px breakpoint only.
 */
interface Props {
	sections: { id: string; title: string }[];
	repoLabel: string;
	repoUrl: string;
}

const { sections, repoLabel, repoUrl } = Astro.props;
---

<nav class="nav">
	<ul>
		{
			sections.map((section) => (
				<li>
					<a href={`#${section.id}`}>{section.title}</a>
				</li>
			))
		}
		<li><a href={repoUrl}>{repoLabel}</a></li>
	</ul>
</nav>

<style>
	.nav {
		/* --bg is opaque, so the sticky row hides whatever scrolls under it. The negative margin
		   pulls the paint into the page container's gutters, which content would otherwise cross. */
		background: var(--bg);
		margin: 0 calc(var(--space-3) * -1);
		padding: var(--space-2) var(--space-3) 0;
		font-size: var(--text-sm);
	}

	/* Chrome, not content: the accent stays reserved for links inside the page body. */
	.nav a {
		color: var(--muted);
		text-decoration: none;
	}

	.nav a:hover {
		color: var(--fg);
		text-decoration: underline;
	}

	/* The rule sits on the ul, not on the bled-out .nav, so it stops at the content column
	   like every other rule on the page. */
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		margin: 0;
		padding: 0 0 var(--space-2);
		border-bottom: 1px solid var(--border);
		list-style: none;
	}

	@media (min-width: 720px) {
		.nav {
			position: sticky;
			top: 0;
			z-index: 1;
			height: var(--nav-height);
			display: flex;
			padding: 0 var(--space-3);
		}

		/* Fills the sticky row, so the rule lands on the row's bottom edge, not under the labels. */
		ul {
			flex: 1;
			align-items: center;
			padding-bottom: 0;
		}
	}
</style>
