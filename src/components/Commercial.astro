---
import { render, type CollectionEntry } from 'astro:content';
import CommercialArt from './graphics/CommercialArt.astro';

/**
 * The single paid entry, after all six sections. Card-shaped but deliberately not in the card grid:
 * full width, and the only block on the page carrying the amber accent, so it reads as an offer and
 * not as part of the open-source stack.
 */
interface Props {
	commercial: CollectionEntry<'commercial'>['data'];
	visdom: CollectionEntry<'visdom'>;
}

const { commercial, visdom } = Astro.props;
const { Content } = await render(visdom);
---

<section id="commercial" class="panel">
	<div class="body">
		<p class="eyebrow">{visdom.data.eyebrow}</p>
		<h2 id={commercial.id}><a href={commercial.url}>{commercial.name}</a></h2>
		<p>{commercial.description}</p>
		<div class="note"><Content /></div>
	</div>
	{/* After the copy in the DOM, beside it on a wide screen: the animal carries through to the one
	    block that is not part of the free stack. */}
	<div class="art"><CommercialArt /></div>
</section>

<style>
	/* The one amber-edged block on a page of green ones. */
	section {
		display: grid;
		gap: var(--space-4);
		justify-items: center;
		margin: var(--space-6) 0 var(--space-5);
		padding: var(--space-4);
		border-color: var(--accent-2);
		background: var(--surface);
	}

	.body {
		justify-self: stretch;
	}

	/* A filled label, not a line of small caps: the one place the amber accent is a solid block. */
	.eyebrow {
		display: inline-block;
		margin: 0 0 var(--space-3);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-pill);
		background: var(--accent-2);
		color: var(--on-accent-2);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0 0 var(--space-2);
		font-size: var(--text-lg);
	}

	h2 a {
		color: var(--accent-2-text);
	}

	p {
		margin: 0;
	}

	.note {
		margin-top: var(--space-3);
		font-size: var(--text-sm);
		color: var(--muted);
	}

	@media (min-width: 720px) {
		section {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			gap: var(--space-5);
			padding: var(--space-5);
		}
	}
</style>
