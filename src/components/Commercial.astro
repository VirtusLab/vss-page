---
import { render, type CollectionEntry } from 'astro:content';
import VisdomLogo from './graphics/VisdomLogo.astro';

/**
 * The single paid entry, after all six sections. Card-shaped but deliberately not in the card grid:
 * full width, and the only block on the page carrying the amber accent, so it reads as an offer and
 * not as part of the open-source stack. No label says "commercial"; the border and the tint set it
 * apart, and the product's own lockup names it.
 */
interface Props {
	commercial: CollectionEntry<'commercial'>['data'];
	visdom: CollectionEntry<'visdom'>;
}

const { commercial, visdom } = Astro.props;
const { Content } = await render(visdom);
---

<section id="commercial" class="panel">
	<div class="body">
		<h2 id={commercial.id}><a href={commercial.url}>{commercial.name}</a></h2>
		<p>{commercial.description}</p>
		<div class="note"><Content /></div>
	</div>
	{/* After the copy in the DOM, beside it on a wide screen: the product's own mark, not the
	    page's frog, because this block is not part of the free stack. */}
	<div class="art"><VisdomLogo name={commercial.name} /></div>
</section>

<style>
	/* The one amber-edged block on a page of green ones. */
	section {
		display: grid;
		gap: var(--space-4);
		justify-items: center;
		margin: var(--space-6) 0 var(--space-5);
		padding: var(--space-4);
		border-color: var(--accent-2);
		background: var(--surface);
	}

	.body {
		justify-self: stretch;
	}

	h2 {
		margin: 0 0 var(--space-2);
		font-size: var(--text-lg);
	}

	h2 a {
		color: var(--accent-2-text);
	}

	p {
		margin: 0;
	}

	.note {
		margin-top: var(--space-3);
		font-size: var(--text-sm);
		color: var(--muted);
	}

	@media (min-width: 720px) {
		section {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			gap: var(--space-5);
			padding: var(--space-5);
		}
	}
</style>
