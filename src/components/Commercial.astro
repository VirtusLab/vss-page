---
import { render, type CollectionEntry } from 'astro:content';

/**
 * The single paid entry, after all six sections. Card-shaped but deliberately not in the card grid:
 * full width, and the only block on the page outlined in the gold accent, so it reads as an offer
 * and not as part of the open-source stack.
 */
interface Props {
	commercial: CollectionEntry<'commercial'>['data'];
	visdom: CollectionEntry<'visdom'>;
}

const { commercial, visdom } = Astro.props;
const { Content } = await render(visdom);
---

<section id="commercial" class="pixel-box">
	<p class="eyebrow">{visdom.data.eyebrow}</p>
	<h2 id={commercial.id}><a href={commercial.url}>{commercial.name}</a></h2>
	<p>{commercial.description}</p>
	<div class="note"><Content /></div>
</section>

<style>
	/* The only box outlined in gold rather than in the page's ink. */
	section {
		margin: var(--space-6) 0 var(--space-5);
		padding: var(--space-4);
		border-color: var(--accent-2);
		background: var(--tint);
	}

	/* A filled label, not a line of small caps: the one place the gold accent is a solid block. */
	.eyebrow {
		display: inline-block;
		margin: 0 0 var(--space-3);
		padding: var(--space-1) var(--space-2);
		background: var(--accent-2);
		color: var(--on-accent-2);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		text-transform: uppercase;
	}

	h2 {
		margin: 0 0 var(--space-2);
		font-size: var(--text-lg);
	}

	p {
		margin: 0;
	}

	.note {
		margin-top: var(--space-3);
		font-size: var(--text-sm);
		color: var(--muted);
	}
</style>
