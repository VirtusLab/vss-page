---
/**
 * The chapter picker fixed to the top edge of every screen. It is the page's only navigation, and
 * works without JavaScript: plain anchors. First the site's name, which jumps back to the top, then
 * the chapters — in a row after a rule on a wide screen, in a panel behind a hamburger on a phone,
 * opened by a checkbox so it needs no script either. Labels come from the same content the
 * chapters render, so picker and headings cannot diverge. The inline script in `index.astro` marks
 * the entry the reader is in with `aria-current="location"`, which is what fills its pill; the home
 * pill never gets it.
 */
interface Props {
	sections: { id: string; title: string }[];
	/** The site's name, on the pill that jumps to the top of the page. */
	homeLabel: string;
	/** Names the snippets chapter, which the first entry jumps to. */
	snippetsLabel: string;
	/** Names the agent-prompt chapter. */
	promptLabel: string;
	/** Names the benefits chapter. Not the benefits heading: the strip needs the short word. */
	benefitsLabel: string;
	/** Accessible name of the bar. Not shown. */
	label: string;
	/** Accessible name of the hamburger that opens the chapter list on a phone. Not shown. */
	menuLabel: string;
}

const { sections, homeLabel, snippetsLabel, promptLabel, benefitsLabel, label, menuLabel } =
	Astro.props;

const entries = [
	{ href: '#snippets', label: snippetsLabel },
	{ href: '#prompt', label: promptLabel },
	{ href: '#benefits', label: benefitsLabel },
	...sections.map((section) => ({ href: `#${section.id}`, label: section.title })),
];
---

<nav class="float" data-float-nav aria-label={label}>
	{/* `#content` is the top of `<main>`, which is the top of the page: `scroll-padding-top` has
	    nothing to push it under the bar, and the hero already keeps clear of it. Outside the list,
	    so the list is the chapters alone — what the panel shows and what the script marks. */}
	<a class="home" href="#content" data-home>{homeLabel}</a>
	{/* The checkbox is the open state; the label is the button. Both are gone on a wide screen. */}
	<input type="checkbox" id="picker-open" class="toggle" />
	<label for="picker-open" class="burger">
		<span class="bars" aria-hidden="true"></span>
		<span class="menu-label">{menuLabel}</span>
	</label>
	{/* `list-style: none` drops list semantics in Safari/VoiceOver; the role puts them back. */}
	<ul role="list">
		{
			entries.map((entry) => (
				<li>
					<a href={entry.href}>{entry.label}</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	/* The side padding is the page gutter, or whatever centres the page's width in a wider window.
	   The bar has no inner wrapper to carry the cap, so the padding is it. */
	.float {
		position: fixed;
		inset: 0 0 auto;
		z-index: 1;
		display: flex;
		min-height: var(--float-nav-height);
		align-items: center;
		justify-content: space-between;
		padding: var(--space-1) max(var(--space-3), (100% - var(--page-width)) / 2);
		border-bottom: var(--border) solid var(--line);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 600;
		/* Opaque first, for browsers without color-mix: the bar must never let text read through. */
		background: var(--bg);
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}

	/* Visually hidden but focusable, so the hamburger can be opened from the keyboard. */
	.toggle {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		border: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* A pill like the chapters', with three bars in it: the middle one is the box, the other two its
	   shadow, so no image or icon font is needed. */
	/* A fixed tile, not padding around the icon: the fill has to be a shape of its own, since the
	   icon is three hairlines with air between them. */
	.burger {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: var(--radius-sm);
		color: var(--fg);
		cursor: pointer;
	}

	.bars {
		position: relative;
		display: block;
		width: 18px;
		height: 2px;
		background: currentColor;
		transition: background 0.15s ease;
	}

	.bars::before,
	.bars::after {
		content: '';
		position: absolute;
		inset: 0;
		background: currentColor;
		transition:
			translate 0.15s ease,
			rotate 0.15s ease;
	}

	.bars::before {
		translate: 0 -6px;
	}

	.bars::after {
		translate: 0 6px;
	}

	/* Open: the tile fills and the outer bars fold into a cross. */
	.toggle:checked ~ .burger .bars {
		background: transparent;
	}

	.toggle:checked ~ .burger .bars::before {
		translate: 0;
		rotate: 45deg;
	}

	.toggle:checked ~ .burger .bars::after {
		translate: 0;
		rotate: -45deg;
	}

	/* Read by screen readers, never shown: names the checkbox, and so the button. */
	.menu-label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* The checkbox holds the focus, so the ring — the global one — is drawn on the button for it. */
	.toggle:focus-visible ~ .burger {
		outline: var(--border-thick) solid var(--accent-2-text);
		outline-offset: var(--border-thick);
	}

	.toggle:checked ~ .burger {
		background: var(--accent);
		color: var(--on-accent);
	}

	/* A panel under the bar, one chapter per row, shown only while the box is checked. Opaque, unlike
	   the bar: it opens over the hero's title, which a frosted list is not legible on. */
	ul {
		display: none;
		position: absolute;
		inset: 100% 0 auto;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
		padding: var(--space-2) var(--space-3);
		list-style: none;
		border-bottom: var(--border) solid var(--line);
		background: var(--bg);
		/* The bar is fixed, so the page cannot scroll a tall panel into view; the panel scrolls. */
		max-height: calc(100dvh - var(--float-nav-height));
		overflow-y: auto;
	}

	.toggle:checked ~ ul {
		display: flex;
	}

	/* A quiet pill that fills with the accent only on hover, focus or as the current chapter: chrome
	   over the page, not in it. */
	.float a {
		display: block;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-pill);
		color: var(--fg);
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	/* The chapter the reader is in, filled like the checked snippet tab; the script is what moves it. */
	.float a:hover,
	.float a[aria-current] {
		background: var(--accent);
		color: var(--on-accent);
	}

	@media (min-width: 720px) {
		.toggle,
		.burger {
			display: none;
		}

		/* The rule between the site's name and the chapters, hung off the pill's right edge rather
		   than drawn inside it, so the hover fill stops at the pill. The margin is the rule's room. */
		.home {
			position: relative;
			margin-right: calc(var(--space-1) * 2 + var(--border));
		}

		.home::after {
			content: '';
			position: absolute;
			top: 50%;
			left: calc(100% + var(--space-1));
			width: var(--border);
			height: 1.25em;
			background: var(--line-strong);
			translate: 0 -50%;
		}

		/* One row that scrolls sideways rather than wrapping, so the bar is one line tall wherever the
		   reader is. The scrollbar is hidden — the strip runs off the right edge, which is the
		   affordance. The padding is not decoration: it is what keeps a focused pill's ring inside the
		   scroll container, which clips anything past its padding box; the negative margin gives that
		   room back, so the first pill still lands where the gap put it. */
		ul {
			display: flex;
			position: static;
			flex: 1;
			flex-direction: row;
			align-items: center;
			min-width: 0;
			margin: 0 calc(var(--space-1) * -1);
			padding: var(--space-1);
			border-bottom: 0;
			background: none;
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scrollbar-width: none;
		}

		ul::-webkit-scrollbar {
			display: none;
		}
	}

	/* The strip only ever runs off the edge on a narrow window, and a mask cannot ask whether it
	   does, so the width is the condition: above this the nine pills always fit. */
	@media (min-width: 720px) and (max-width: 1000px) {
		ul {
			mask-image: linear-gradient(to right, black calc(100% - var(--space-4)), transparent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.float a,
		.bars,
		.bars::before,
		.bars::after {
			transition: none;
		}
	}
</style>
