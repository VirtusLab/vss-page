---
/**
 * The chapter picker fixed to the top edge of every screen. It is the page's only navigation, and
 * works without JavaScript: plain anchors. First the site's name, which jumps back to the top, then
 * a rule, then the chapters. Labels come from the same content the chapters render, so picker and
 * headings cannot diverge. The inline script in `index.astro` marks the entry the reader is in with
 * `aria-current="location"`, which is what fills its pill; the home pill never gets it.
 */
interface Props {
	sections: { id: string; title: string }[];
	/** The site's name, on the pill that jumps to the top of the page. */
	homeLabel: string;
	/** Names the snippets chapter, which the first entry jumps to. */
	snippetsLabel: string;
	/** Names the benefits chapter. Not the benefits heading: the strip needs the short word. */
	benefitsLabel: string;
	/** Accessible name of the bar. Not shown. */
	label: string;
}

const { sections, homeLabel, snippetsLabel, benefitsLabel, label } = Astro.props;

const entries = [
	{ href: '#snippets', label: snippetsLabel },
	{ href: '#benefits', label: benefitsLabel },
	...sections.map((section) => ({ href: `#${section.id}`, label: section.title })),
];
---

<nav class="float" data-float-nav aria-label={label}>
	{/* `list-style: none` drops list semantics in Safari/VoiceOver; the role puts them back. */}
	<ul role="list">
		{/* `#content` is the top of `<main>`, which is the top of the page: `scroll-padding-top` has
		    nothing to push it under the bar, and the hero already keeps clear of it. */}
		<li class="home">
			<a href="#content" data-home>{homeLabel}</a>
		</li>
		{
			entries.map((entry) => (
				<li>
					<a href={entry.href}>{entry.label}</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.float {
		position: fixed;
		inset: 0 0 auto;
		z-index: 1;
		display: flex;
		min-height: var(--float-nav-height);
		align-items: center;
		border-bottom: var(--border) solid var(--line);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 600;
		/* Opaque first, for browsers without color-mix: the bar must never let text read through. */
		background: var(--bg);
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}

	/* One row at every width: below the breakpoint it scrolls sideways rather than wrapping, so the
	   bar is one line tall wherever the reader is. The scrollbar is hidden — the strip runs off the
	   right edge, which is the affordance. The vertical padding is not decoration: it is what keeps
	   a focused pill's ring inside the scroll container, which clips anything past its padding box. */
	ul {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		width: 100%;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: var(--space-1) var(--space-3);
		list-style: none;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
	}

	ul::-webkit-scrollbar {
		display: none;
	}

	/* The strip only ever runs off the edge on a narrow window, and a mask cannot ask whether it
	   does, so the width is the condition: above this the eight pills always fit. */
	@media (max-width: 1000px) {
		ul {
			mask-image: linear-gradient(
				to right,
				black calc(100% - var(--space-4)),
				transparent
			);
		}
	}

	/* The rule between the site's name and the chapters. On the item, not the link, so the pill's
	   hover fill stops at its own edge. */
	.home {
		display: flex;
		align-items: center;
		gap: var(--space-1);
	}

	.home::after {
		content: '';
		width: var(--border);
		height: 1.25em;
		background: var(--line-strong);
	}

	/* A quiet pill that fills with the accent only on hover, focus or as the current chapter: chrome
	   over the page, not in it. */
	.float a {
		display: block;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-pill);
		color: var(--fg);
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	/* The chapter the reader is in, filled like the checked snippet tab; the script is what moves it. */
	.float a:hover,
	.float a[aria-current] {
		background: var(--accent);
		color: var(--on-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.float a {
			transition: none;
		}
	}
</style>
