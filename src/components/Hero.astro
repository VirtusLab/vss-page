---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/base';
import HeroArt from './graphics/HeroArt.astro';

/** Title, tagline, lede, the two CTAs, and one line pointing coding agents at llms.txt and scala-skill. */
interface Props {
	hero: CollectionEntry<'hero'>['data'];
	labels: CollectionEntry<'labels'>['data'];
}

const { hero, labels } = Astro.props;
---

<header class="hero" id="hero">
	<div class="cols">
		<div class="text">
			<h1>{hero.title} ({hero.acronym})</h1>
			<p class="tagline">{hero.tagline}</p>
			<p class="lede">{hero.lede}</p>
			<p class="cta-row">
				<a class="cta" href={hero.ctaPrimaryHref}>{hero.ctaPrimaryLabel}</a>
				<a class="cta cta-outline" href={hero.ctaSecondaryHref}>{hero.ctaSecondaryLabel}</a>
			</p>
			{/* Kept on one line: the build drops a whitespace-only text node between two tags. */}
			<p class="agents">
				{hero.agentLabel} <a href={withBase(labels.llmsHref)}>{labels.llmsLabel}</a> · <a href={hero.agentSkillHref}>{hero.agentSkillLabel}</a>
			</p>
		</div>
		<div class="art"><HeroArt /></div>
	</div>
</header>

<style>
	/* The fixed picker covers the top edge, so the hero starts below it. */
	.hero {
		padding: calc(var(--float-nav-height) + var(--space-5)) 0 var(--space-4);
	}

	.cols {
		display: grid;
		gap: var(--space-4);
	}

	/* The bright-green mark that opens the page. */
	.text::before {
		content: '';
		display: block;
		width: var(--space-5);
		height: var(--rule);
		margin-bottom: var(--space-3);
		border-radius: var(--radius-pill);
		background: var(--accent-bright);
	}

	h1 {
		max-width: var(--measure);
		margin: 0 0 var(--space-3);
		font-size: var(--text-2xl);
	}

	.tagline {
		margin: 0 0 var(--space-3);
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.lede {
		margin: 0 0 var(--space-4);
		font-size: var(--text-base);
		color: var(--muted);
	}

	/* Free of the global `p` measure, which is a line-length cap for prose and would be just short
	   of the pair. */
	.cta-row {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		max-width: none;
		margin: 0;
	}

	/* The page's two buttons, both pills of the same size. The only other filled button is a
	   promo's amber pill, which carries that block's accent, not this one. */
	.cta {
		--cta-rest-shadow: var(--shadow-soft);
		display: inline-block;
		/* Sides at --space-4, not --space-5: the pair plus the gap has to fit the text column
		   beside the art on a 1280px screen. */
		padding: var(--space-3) var(--space-4);
		border: var(--border-thick) solid var(--accent);
		border-radius: var(--radius-pill);
		background: var(--accent);
		box-shadow: var(--cta-rest-shadow);
		color: var(--on-accent);
		text-align: center;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}

	.cta:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-lift);
	}

	.cta:active {
		transform: translateY(0);
		box-shadow: var(--cta-rest-shadow);
	}

	.cta-outline {
		--cta-rest-shadow: none;
		background: transparent;
		color: var(--accent);
	}

	.agents {
		margin: var(--space-4) 0 0;
		font-size: var(--text-sm);
		color: var(--muted);
	}

	/* 320px is the image's CSS size; the PNG is 2x. The same cap at both widths: on a 360px phone the
	   column is 328px and still holds it. */
	.art {
		width: 100%;
		max-width: 320px;
		justify-self: center;
	}

	@media (min-width: 720px) {
		.hero {
			padding-top: var(--space-6);
		}

		.cta-row {
			flex-direction: row;
			flex-wrap: wrap;
		}

		/* Text first, art beside it. The art track is a fixed 320px, the image's size, and the text
		   takes whatever is left. */
		.cols {
			grid-template-columns: minmax(0, 1fr) 320px;
			align-items: center;
			gap: var(--space-4);
		}

		/* No bleed into the page gutter: the art stops on the column line. */
		.art {
			justify-self: end;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta {
			transition: none;
		}

		.cta:hover {
			transform: none;
		}
	}
</style>
