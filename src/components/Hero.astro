---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/base';
import HeroArt from './graphics/HeroArt.astro';

/** Title, tagline, lede, the single CTA, and one line pointing coding agents at llms.txt and scala-skill. */
interface Props {
	hero: CollectionEntry<'hero'>['data'];
	labels: CollectionEntry<'labels'>['data'];
}

const { hero, labels } = Astro.props;
---

<header class="hero" id="hero">
	<div class="cols">
		<div class="text">
			<h1>{hero.title} ({hero.acronym})</h1>
			<p class="tagline">{hero.tagline}</p>
			<p class="lede">{hero.lede}</p>
			<p class="cta-row"><a class="cta" href={hero.ctaHref}>{hero.ctaLabel}</a></p>
			{/* Kept on one line: the build drops a whitespace-only text node between two tags. */}
			<p class="agents">
				{hero.agentLabel} <a href={withBase(labels.llmsHref)}>{labels.llmsLabel}</a> · <a href={hero.agentSkillHref}>{hero.agentSkillLabel}</a>
			</p>
		</div>
		<div class="art"><HeroArt /></div>
	</div>
</header>

<style>
	.hero {
		padding: var(--space-5) 0 var(--space-4);
	}

	.cols {
		display: grid;
		gap: var(--space-4);
	}

	/* The bright-green mark that opens the page. */
	.text::before {
		content: '';
		display: block;
		width: var(--space-5);
		height: var(--rule);
		margin-bottom: var(--space-3);
		border-radius: var(--radius-pill);
		background: var(--accent-bright);
	}

	h1 {
		max-width: var(--measure);
		margin: 0 0 var(--space-3);
		font-size: var(--text-2xl);
	}

	.tagline {
		margin: 0 0 var(--space-3);
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.lede {
		margin: 0 0 var(--space-4);
		font-size: var(--text-base);
		color: var(--muted);
	}

	.cta-row {
		margin: 0;
	}

	/* The one filled button on the page: solid VirtusLab green, pill-shaped, soft shadow. */
	.cta {
		display: inline-block;
		padding: var(--space-3) var(--space-5);
		border-radius: var(--radius-pill);
		background: var(--accent);
		box-shadow: var(--shadow-soft);
		color: var(--on-accent);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}

	.cta:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-lift);
	}

	.cta:active {
		transform: translateY(0);
		box-shadow: var(--shadow-soft);
	}

	.agents {
		margin: var(--space-4) 0 0;
		font-size: var(--text-sm);
		color: var(--muted);
	}

	/* 320px is twice the scene's 160px native grid, so every logical pixel is exactly two device
	   ones. The same cap at both widths; on a 360px phone the column is 328px and still holds it. */
	.art {
		width: 100%;
		max-width: 320px;
		justify-self: center;
	}

	@media (min-width: 720px) {
		.hero {
			padding-top: var(--space-6);
		}

		/* Text first, art beside it. The art track is a fixed 320px — twice the scene's 160px native
		   grid, so the pixels stay square — and the text takes whatever is left. */
		.cols {
			grid-template-columns: minmax(0, 1fr) 320px;
			align-items: center;
			gap: var(--space-4);
		}

		/* No bleed into the page gutter: the art stops on the column line. */
		.art {
			justify-self: end;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta {
			transition: none;
		}

		.cta:hover {
			transform: none;
		}
	}
</style>
