---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/base';
import HeroArt from './graphics/HeroArt.astro';
import Divider from './graphics/Divider.astro';

/** Title, tagline, lede, the single CTA, and one line pointing coding agents at llms.txt and scala-skill. */
interface Props {
	hero: CollectionEntry<'hero'>['data'];
	labels: CollectionEntry<'labels'>['data'];
}

const { hero, labels } = Astro.props;
---

<header class="hero">
	<div class="cols">
		<div class="text">
			<h1>{hero.title}</h1>
			<p class="tagline">{hero.tagline}</p>
			<p class="lede">{hero.lede}</p>
			<p class="cta-row"><a class="cta" href={hero.ctaHref}>{hero.ctaLabel}</a></p>
			{/* Kept on one line: the build drops a whitespace-only text node between two tags. */}
			<p class="agents">
				{hero.agentLabel} <a href={withBase(labels.llmsHref)}>{labels.llmsLabel}</a> · <a href={hero.agentSkillHref}>{hero.agentSkillLabel}</a>
			</p>
		</div>
		<div class="art"><HeroArt /></div>
	</div>
	<Divider />
</header>

<style>
	.hero {
		padding: var(--space-5) 0 var(--space-4);
	}

	.cols {
		display: grid;
		gap: var(--space-4);
		margin-bottom: var(--space-5);
	}

	/* The bright-green mark that opens the page; the same rule runs down every section intro. */
	.text::before {
		content: '';
		display: block;
		width: var(--space-5);
		height: var(--rule);
		margin-bottom: var(--space-3);
		border-radius: var(--radius-pill);
		background: var(--accent-bright);
	}

	h1 {
		max-width: var(--measure);
		margin: 0 0 var(--space-3);
		font-size: var(--text-2xl);
	}

	.tagline {
		margin: 0 0 var(--space-3);
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.lede {
		margin: 0 0 var(--space-4);
		font-size: var(--text-base);
		color: var(--muted);
	}

	.cta-row {
		margin: 0;
	}

	/* The one filled button on the page: solid VirtusLab green, pill-shaped, soft shadow. */
	.cta {
		display: inline-block;
		padding: var(--space-3) var(--space-5);
		border-radius: var(--radius-pill);
		background: var(--accent);
		box-shadow: var(--shadow-soft);
		color: var(--on-accent);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}

	.cta:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-lift);
	}

	.cta:active {
		transform: translateY(0);
		box-shadow: var(--shadow-soft);
	}

	.agents {
		margin: var(--space-4) 0 0;
		font-size: var(--text-sm);
		color: var(--muted);
	}

	.art {
		width: 100%;
		max-width: 32rem;
		justify-self: center;
	}

	@media (min-width: 720px) {
		.hero {
			padding-top: var(--space-6);
		}

		/* Text first, art beside it — and the art gets the wider column: the illustration is the
		   page's one big moment. */
		.cols {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
			align-items: center;
			gap: var(--space-4);
		}

		/* The disc bleeds out through the page container's own gutter, so the art runs to the edge
		   of the page rather than stopping on the column line. The negative margin is exactly the
		   container's padding, so it can never push the page wider than the viewport. */
		.art {
			justify-self: end;
			margin-right: calc(var(--space-3) * -1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta {
			transition: none;
		}

		.cta:hover {
			transform: none;
		}
	}
</style>
