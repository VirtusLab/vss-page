---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/base';

/** Title, tagline, lede, the single CTA, and one line pointing coding agents at llms.txt and scala-skill. */
interface Props {
	hero: CollectionEntry<'hero'>['data'];
	labels: CollectionEntry<'labels'>['data'];
}

const { hero, labels } = Astro.props;
---

<header class="hero">
	<h1>{hero.title}</h1>
	<p class="tagline">{hero.tagline}</p>
	<p class="lede">{hero.lede}</p>
	<p><a class="cta" href={hero.ctaHref}>{hero.ctaLabel}</a></p>
	{/* Kept on one line: the build drops a whitespace-only text node between two tags. */}
	<p class="agents">
		{hero.agentLabel} <a href={withBase(labels.llmsHref)}>{labels.llmsLabel}</a> · <a href={hero.agentSkillHref}>{hero.agentSkillLabel}</a>
	</p>
</header>

<style>
	.hero {
		padding: var(--space-6) 0 var(--space-5);
	}

	h1 {
		max-width: var(--measure);
		margin: 0 0 var(--space-3);
		font-size: var(--text-2xl);
	}

	.tagline {
		margin: 0 0 var(--space-3);
		font-size: var(--text-lg);
		color: var(--muted);
	}

	.lede {
		margin: 0 0 var(--space-4);
		font-size: var(--text-base);
		color: var(--muted);
	}

	.cta {
		display: inline-block;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius);
		background: var(--accent);
		color: var(--on-accent);
		text-decoration: none;
		font-weight: 600;
	}

	.agents {
		margin: var(--space-3) 0 0;
		font-size: var(--text-sm);
		color: var(--muted);
	}
</style>
