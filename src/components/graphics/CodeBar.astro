---
import { withBase } from '../../lib/base';

/**
 * The mark in the code panel's title bar: `public/art/codebar.png`, a 33×11 pixel-art sprite of the
 * frog's head peeking over a bar, exported at ×8 and shown at 66×22 — three times `--mark`. The bar
 * strip itself, and the panel's outline and shadow, are CSS on the panel. Decorative, hence
 * `aria-hidden`.
 */
---

<img
	class="bar-art pixel"
	src={withBase('/art/codebar.png')}
	width="66"
	height="22"
	alt=""
	aria-hidden="true"
	decoding="async"
	loading="lazy"
/>

<style>
	.bar-art {
		display: block;
		height: var(--mark);
		width: auto;
	}
</style>
