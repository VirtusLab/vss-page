---
/**
 * The contents of the code panel's title bar: the frog mark, then three window lights. The bar strip
 * itself, and the panel's outline and shadow, are CSS on the panel. The mark is a three-quarter head
 * cropped by the bar's lower edge, looking over it into the panel — a crop of the character, not a
 * face on a circle. The turrets are half-buried in the skull and nearly touch each other, which is
 * what keeps it one head rather than two, and both pupil bars are half the amber's width so the eyes
 * still read as eyes at 22px. Decorative, hence `aria-hidden`.
 */
---

<svg class="bar-art" viewBox="0 0 66 24" aria-hidden="true" focusable="false">
	{/* The far cheek is the head's own shade copy, pushed further right than elsewhere so the plane
	    turning out of the light is a broad crescent rather than a rim. The panel renders one of these
	    per snippet tab, so the mark carries no id and no clip of its own. */}
	<ellipse cx="17.6" cy="20.4" rx="14" ry="11" transform="rotate(-8 17.6 20.4)" fill="var(--art-shade)"></ellipse>
	<ellipse cx="14" cy="19" rx="14" ry="11" transform="rotate(-8 14 19)" fill="var(--art-frog)"></ellipse>

	<circle cx="17.3" cy="9.9" r="4.9" fill="var(--art-shade)"></circle>
	<circle cx="16.5" cy="9.1" r="4.9" fill="var(--art-frog)"></circle>
	<circle cx="8.3" cy="11.3" r="5.4" fill="var(--art-shade)"></circle>
	<circle cx="7.5" cy="10.5" r="5.4" fill="var(--art-frog)"></circle>

	<circle cx="17" cy="9.6" r="3.7" fill="var(--art-eye-dark)"></circle>
	<circle cx="16.5" cy="9.1" r="3.2" fill="var(--art-eye)"></circle>
	<circle cx="8" cy="11" r="4.1" fill="var(--art-eye-dark)"></circle>
	<circle cx="7.5" cy="10.5" r="3.6" fill="var(--art-eye)"></circle>

	{/* Half the amber's width, so amber shows on all four sides of the bar. */}
	<rect x="14.7" y="8.15" width="3.2" height="1.9" rx="0.95" fill="var(--art-ink)"></rect>
	<rect x="5.5" y="9.45" width="3.6" height="2.1" rx="1.05" fill="var(--art-ink)"></rect>

	<g fill="var(--art-ink)">
		<ellipse cx="5.2" cy="17.4" rx="1" ry="0.8"></ellipse>
		<ellipse cx="9.2" cy="16.6" rx="0.8" ry="0.6"></ellipse>
	</g>
	<path
		d="M 3.4 20.4 C 6.6 23.4 10.8 24 15 23.2"
		fill="none"
		stroke="var(--art-shade)"
		stroke-width="1.6"
		stroke-linecap="round"></path>

	<circle cx="42" cy="12" r="3.4" fill="var(--art-eye)"></circle>
	<circle cx="52" cy="12" r="3.4" fill="var(--art-frog-light)"></circle>
	<circle cx="62" cy="12" r="3.4" fill="var(--art-disc-edge)"></circle>
</svg>

<style>
	.bar-art {
		display: block;
		height: var(--mark);
		width: auto;
	}
</style>
