---
import { withBase } from '../../lib/base';

/**
 * The mark in the code panel's title bar: `public/art/codebar.png`, a small leaf sprig rendered on its
 * own cream plate, exported at 2x and shown at 66×22 — `--mark` tall. The panel's outline and shadow
 * are CSS on the panel. Decorative, hence `aria-hidden`.
 */
---

<img
	class="bar-art plate"
	src={withBase('/art/codebar.png')}
	width="66"
	height="22"
	alt=""
	aria-hidden="true"
	decoding="async"
	loading="lazy"
/>

<style>
	.bar-art {
		display: block;
		height: var(--mark);
		width: auto;
	}
</style>
