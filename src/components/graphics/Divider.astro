---
import { withBase } from '../../lib/base';

/**
 * The band that separates the major blocks of the page: `public/art/divider.png`, a 160×24 pixel-art
 * strip of pond exported at ×4 and shown at 320×48, centred. Transparent above the waterline and
 * dithered out at both ends, so it needs no rule behind it. Decorative, hence `aria-hidden`.
 */
---

<div class="divider" aria-hidden="true">
	<img
		class="sprig pixel"
		src={withBase('/art/divider.png')}
		width="320"
		height="48"
		alt=""
		aria-hidden="true"
		decoding="async"
		loading="lazy"
	/>
</div>

<style>
	/* Its own air above and below: the strip closes a chapter wherever it is placed. */
	.divider {
		display: flex;
		justify-content: center;
		margin: var(--space-4) 0;
	}

	/* Fixed at ×2 of the native grid, and never wider than a narrow window. */
	.sprig {
		display: block;
		flex: none;
		width: 320px;
		max-width: 100%;
		height: auto;
	}
</style>
