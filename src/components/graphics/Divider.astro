---
import { withBase } from '../../lib/base';

/**
 * The band that separates the major blocks of the page: `public/art/divider.png`, a transparent render
 * of a horizontal leafy branch, exported at 2x and shown at 320×48, centred. Decorative, hence
 * `aria-hidden`.
 */
---

<div class="divider" aria-hidden="true">
	<img
		class="sprig"
		src={withBase('/art/divider.png')}
		width="320"
		height="48"
		alt=""
		aria-hidden="true"
		decoding="async"
		loading="lazy"
	/>
</div>

<style>
	/* Its own air above and below: the strip closes a chapter wherever it is placed. Not on a phone:
	   there the chapters already stack with air between them, and the branch would cost a screen's
	   worth of scroll. */
	.divider {
		display: none;
		justify-content: center;
		margin: var(--space-4) 0;
	}

	@media (min-width: 720px) {
		.divider {
			display: flex;
		}
	}

	/* Fixed at the image's CSS size, and never wider than a narrow window. */
	.sprig {
		display: block;
		flex: none;
		width: 320px;
		max-width: 100%;
		height: auto;
	}
</style>
