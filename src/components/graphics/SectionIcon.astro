---
import { withBase } from '../../lib/base';

/**
 * One icon per stack section, keyed by the section id: `public/art/icon-<name>.png`, a transparent
 * render of the section's subject, exported at 2x and shown at 64×64 (`--icon`). Decorative, hence
 * `aria-hidden`.
 */
interface Props {
	/** A section id from `content/components.yaml`. An id with no icon fails the build. */
	name: string;
}

const { name } = Astro.props;
const drawn = ['template', 'language', 'tooling', 'backend', 'ai', 'devops'];
if (!drawn.includes(name)) throw new Error(`No icon drawn for section "${name}"`);
---

<img
	class="icon"
	src={withBase(`/art/icon-${name}.png`)}
	width="64"
	height="64"
	alt=""
	aria-hidden="true"
	decoding="async"
	loading="lazy"
/>

<style>
	.icon {
		display: block;
		flex: none;
		width: var(--icon);
		height: var(--icon);
	}
</style>
