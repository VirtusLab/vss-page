				<ellipse cx="23" cy="30.4" rx="2.8" ry="2.2" transform="rotate(-20 23 30.4)" fill="var(--art-belly)"></ellipse>
				<path
				d="M 31 -8 C 15 6 15 30 31 46 C 28 40 23.5 32 23.5 19 C 23.5 7 28 -2 31 -8 Z"
				fill="var(--art-leaf)"></path>
				<path
				d="M 28 1 C 25 7 23.5 13 23.5 19 C 23.5 32 28 40 31 46 C 28.8 38 27 30 27 19 C 27 13 27.4 6.6 28 1 Z"
				fill="var(--art-shade)"></path>
				<path d="M 23 32 L 15 39" fill="none" stroke="var(--art-frog)" stroke-width="3.6" stroke-linecap="round"></path>
				<ellipse cx="13.6" cy="40" rx="3.2" ry="2.1" transform="rotate(-16 13.6 40)" fill="var(--art-frog)"></ellipse>
				<g fill="var(--art-frog-light)">
				<circle cx="11" cy="40.4" r="1.5"></circle>
				<circle cx="13.4" cy="42.2" r="1.5"></circle>
