					<ellipse cx="28.2" cy="36.2" rx="6.2" ry="6.4" transform="rotate(14 28.2 36.2)" fill="var(--art-shade)"></ellipse>
					<ellipse cx="27" cy="35" rx="6.2" ry="6.4" transform="rotate(14 27 35)" fill="var(--art-frog)"></ellipse>
