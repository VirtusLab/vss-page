---
import { withBase } from '../../lib/base';

/**
 * One icon per stack section, keyed by the section id: `public/art/icon-<name>.png`, a 32×32
 * pixel-art sprite exported at ×4 and shown at `--icon`. Drawn on transparency with an outline that
 * survives both grounds. Decorative, hence `aria-hidden`.
 */
interface Props {
	/** A section id from `content/components.yaml`. An id with no icon fails the build. */
	name: string;
}

const { name } = Astro.props;
const drawn = ['template', 'language', 'tooling', 'backend', 'ai', 'devops'];
if (!drawn.includes(name)) throw new Error(`No frog icon drawn for section "${name}"`);
---

<img
	class="icon pixel"
	src={withBase(`/art/icon-${name}.png`)}
	width="48"
	height="48"
	alt=""
	aria-hidden="true"
	decoding="async"
	loading="lazy"
/>

<style>
	.icon {
		display: block;
		flex: none;
		width: var(--icon);
		height: var(--icon);
	}
</style>
