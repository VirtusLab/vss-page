---
/**
 * One icon per stack section, keyed by the section id. Each is a different pose of the same frog on
 * a rounded tile, with one prop over 40% of the tile cropped by an edge — so the six read apart from
 * silhouette alone at 48px, rather than as one frog wearing six stickers. The character is the one
 * on the sheet: head 1.15× the body's width and 0.8× its height, turrets rising out of the skull,
 * and a pupil bar half the amber's width so amber shows on all four sides. Same light as every other
 * asset: a shade copy offset down-right under each form, contact shadows down-right. Strokes are
 * only 1.6 / 2.4 / 3.6, this scale's three steps. Decorative, hence `aria-hidden`.
 */
interface Props {
	/** A section id from `content/components.yaml`. An id with no icon fails the build. */
	name: string;
}

const { name } = Astro.props;
const drawn = ['template', 'language', 'tooling', 'backend', 'ai', 'devops'];
if (!drawn.includes(name)) throw new Error(`No frog icon drawn for section "${name}"`);
---

<svg class="icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
	<rect
		x="0.8"
		y="0.8"
		width="46.4"
		height="46.4"
		rx="11"
		fill="var(--art-disc)"
		stroke="var(--art-disc-edge)"
		stroke-width="1.6"></rect>
	{
		name === 'template' && (
			<g>
				{/* Stepping out through a leaf-shaped frame; the frame's near limb crosses in front of the shoulder, so the frog is coming through it and not standing beside it. */}
