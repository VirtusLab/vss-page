---
/**
 * The hero illustration: a tree frog sitting on a lily pad inside a lit disc, built from layered
 * ellipses and lens-shaped leaves — no outlines, no pixels. The frog sits right of the disc's centre
 * with its head and gaze turned back towards the headline, and the leaves break the disc at one
 * corner rather than four. Every fill is an `--art-*` token, so the whole scene recolours between
 * light and dark. Decorative, hence `aria-hidden`.
 */
---

<svg class="hero-art" viewBox="0 0 320 300" aria-hidden="true" focusable="false">
	<defs>
		{/* One lens-shaped leaf, reused at several sizes and angles. `use` inherits the fill for the
		    blade; the vein carries its own stroke, so every leaf is veined the same way. */}
		<g id="leaf-shape">
			<path d="M -60 0 C -34 -33 34 -33 60 0 C 34 33 -34 33 -60 0 Z"></path>
			<path
				d="M -48 0 L 48 0"
				fill="none"
				stroke="var(--art-disc-core)"
				stroke-width="5"
				stroke-linecap="round"></path>
		</g>
		{/* One eye, drawn about its own centre and placed twice by `use`. The pupil sits left of
		    centre in both, which is what turns the gaze towards the headline. */}
		<g id="eye">
			<circle r="39" fill="var(--art-frog-light)"></circle>
			<circle r="29" fill="var(--art-eye-dark)"></circle>
			<circle r="25" fill="var(--art-eye)"></circle>
			<ellipse cx="-6" rx="9" ry="17" fill="var(--art-ink)"></ellipse>
			<circle cx="-14" cy="-11" r="7" fill="var(--art-shine)"></circle>
			<circle cx="3" cy="11" r="3.5" fill="var(--art-shine)" opacity="0.7"></circle>
		</g>
		{/* The disc is lit from above rather than flat, so the frog sits in front of light and not
		    on a plate. */}
		<radialGradient id="disc-fill" cx="46%" cy="36%" r="72%">
			<stop offset="0" stop-color="var(--art-disc-core)"></stop>
			<stop offset="1" stop-color="var(--art-disc)"></stop>
		</radialGradient>
		{/* The eyelids slide inside these, so a closing lid never spills onto the face. */}
		<clipPath id="eye-clip-left"><circle cx="122" cy="88" r="29"></circle></clipPath>
		<clipPath id="eye-clip-right"><circle cx="218" cy="88" r="29"></circle></clipPath>
	</defs>

	{/* Three leaves at one corner, on the headline's side, each turned along the line from the disc
	    centre so what the disc hides is the stem end and what shows is a whole leaf tip. */}
	<g class="sway" style="--sway-delay: 0s">
		<use href="#leaf-shape" transform="translate(38 54) rotate(41) scale(0.82)" fill="var(--art-leaf)"></use>
	</g>
	<g class="sway" style="--sway-delay: -2.6s">
		<use href="#leaf-shape" transform="translate(84 22) rotate(20) scale(0.58)" fill="var(--art-leaf-light)"></use>
	</g>

	{/* The disc: the page's one big geometric shape, the thing the frog is framed by. */}
	<circle cx="160" cy="150" r="136" fill="url(#disc-fill)"></circle>
	<circle cx="160" cy="150" r="135" fill="none" stroke="var(--art-disc-edge)" stroke-width="2"></circle>

	{/* Lily pad, with veins radiating from the point the frog is sitting on. */}
	<ellipse cx="172" cy="252" rx="126" ry="28" fill="var(--art-leaf)"></ellipse>
	<ellipse cx="172" cy="247" rx="126" ry="25" fill="var(--art-leaf-light)"></ellipse>
	<g fill="none" stroke="var(--art-leaf)" stroke-width="2" stroke-linecap="round" opacity="0.55">
		<path d="M 172 247 L 58 238"></path>
		<path d="M 172 247 L 286 238"></path>
		<path d="M 172 247 L 84 264"></path>
		<path d="M 172 247 L 260 264"></path>
	</g>

	{/* Back legs: folded haunches, then a webbed foot on each side. Every toe overlaps the foot bar
	    in both axes, so the three pads read as one foot and not as loose circles on the pad. */}
	<g fill="var(--art-frog-dark)">
		<ellipse cx="106" cy="200" rx="44" ry="37" transform="rotate(-16 106 200)"></ellipse>
		<ellipse cx="250" cy="200" rx="44" ry="37" transform="rotate(16 250 200)"></ellipse>
		<rect x="84" y="231" width="60" height="23" rx="11.5"></rect>
		<rect x="212" y="231" width="60" height="23" rx="11.5"></rect>
		<circle cx="90" cy="225" r="10"></circle>
		<circle cx="82" cy="243" r="10"></circle>
		<circle cx="90" cy="261" r="10"></circle>
		<circle cx="266" cy="225" r="10"></circle>
		<circle cx="274" cy="243" r="10"></circle>
		<circle cx="266" cy="261" r="10"></circle>
	</g>

	{/* Body and head are two overlapping ellipses: a frog has no neck. The head sits eight units left
	    of the body, which is what reads as the frog looking back over its shoulder. */}
	<ellipse cx="178" cy="190" rx="86" ry="62" fill="var(--art-frog)"></ellipse>
	<ellipse cx="170" cy="132" rx="80" ry="60" fill="var(--art-frog)"></ellipse>
	<ellipse cx="166" cy="106" rx="58" ry="32" fill="var(--art-frog-light)" opacity="0.6"></ellipse>
	<ellipse cx="180" cy="204" rx="54" ry="46" fill="var(--art-belly)"></ellipse>

	{/* Front arms, angled out at the wrist, each ending in three toe pads. */}
	<g fill="var(--art-frog)">
		<rect x="109" y="180" width="26" height="70" rx="13" transform="rotate(7 122 215)"></rect>
		<rect x="225" y="180" width="26" height="70" rx="13" transform="rotate(-7 238 215)"></rect>
	</g>
	<g fill="var(--art-frog-light)">
		<circle cx="111" cy="245" r="8.5"></circle>
		<circle cx="122" cy="252" r="8.5"></circle>
		<circle cx="134" cy="246" r="8.5"></circle>
		<circle cx="227" cy="246" r="8.5"></circle>
		<circle cx="238" cy="252" r="8.5"></circle>
		<circle cx="250" cy="245" r="8.5"></circle>
	</g>

	{/* Eyes: the same drawing placed twice. */}
	<use href="#eye" x="122" y="88"></use>
	<use href="#eye" x="218" y="88"></use>
	{/* Lids park above the eye and drop through it on the blink cycle. */}
	<g clip-path="url(#eye-clip-left)">
		<circle class="lid" cx="122" cy="88" r="30" fill="var(--art-frog-light)"></circle>
	</g>
	<g clip-path="url(#eye-clip-right)">
		<circle class="lid" cx="218" cy="88" r="30" fill="var(--art-frog-light)"></circle>
	</g>

	{/* Nostrils and a wide mouth: the two marks that make the blob read as a face. */}
	<g fill="var(--art-frog-dark)">
		<ellipse cx="156" cy="128" rx="4.5" ry="3.5"></ellipse>
		<ellipse cx="184" cy="128" rx="4.5" ry="3.5"></ellipse>
	</g>
	<path
		d="M 130 152 Q 170 184 210 152"
		fill="none"
		stroke="var(--art-frog-dark)"
		stroke-width="6"
		stroke-linecap="round"></path>

	{/* Three points of amber drifting in the dark: the only motion above the frog. */}
	<g fill="var(--art-eye)">
		<circle class="glow" style="--glow-delay: 0s" cx="50" cy="122" r="5"></circle>
		<circle class="glow" style="--glow-delay: -1.4s" cx="284" cy="146" r="4"></circle>
		<circle class="glow" style="--glow-delay: -2.8s" cx="72" cy="76" r="3.5"></circle>
	</g>

	{/* One leaf in front of the pad, so the frog sits inside the scene and not on top of it. The
	    transform lives on an inner element: `.sway` animates the outer group's CSS transform, which
	    would otherwise replace this attribute rather than compose with it. */}
	<g class="sway" style="--sway-delay: -0.7s">
		<use href="#leaf-shape" transform="translate(52 250) rotate(-38) scale(0.64)" fill="var(--art-leaf)"></use>
	</g>
</svg>

<style>
	/* The wrapper in Hero.astro owns the width; the art fills it. `overflow: visible` because the
	   upper-left leaf tips reach past the viewBox edge into the page gutter on purpose. */
	.hero-art {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	/* Parked above the eye for most of the cycle, so the frog is open-eyed by default. */
	.lid {
		transform: translateY(-62px);
		animation: blink 7s ease-in-out infinite;
	}

	.sway {
		transform-origin: 160px 180px;
		animation: sway 9s ease-in-out infinite;
		animation-delay: var(--sway-delay);
	}

	.glow {
		animation: glow 4.5s ease-in-out infinite;
		animation-delay: var(--glow-delay);
	}

	@keyframes blink {
		0%,
		92%,
		100% {
			transform: translateY(-62px);
		}
		95.5% {
			transform: translateY(0);
		}
	}

	@keyframes sway {
		50% {
			transform: rotate(1.4deg);
		}
	}

	@keyframes glow {
		0%,
		100% {
			opacity: 0.35;
		}
		50% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lid,
		.sway,
		.glow {
			animation: none;
		}
	}
</style>
