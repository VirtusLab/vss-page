---
import { withBase } from '../../lib/base';

/**
 * The hero illustration: `public/art/hero.png`, a transparent render of the wooden Scala logo and its
 * branch, exported at 2x and shown at 320×320. Decorative, hence `aria-hidden`. Eager, because it is
 * above the fold.
 */
---

<img
	class="hero-art"
	src={withBase('/art/hero.png')}
	width="320"
	height="320"
	alt=""
	aria-hidden="true"
	decoding="async"
	loading="eager"
/>

<style>
	/* Fills the column and scales with it; the cap is on the wrapper in `Hero.astro`. */
	.hero-art {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
