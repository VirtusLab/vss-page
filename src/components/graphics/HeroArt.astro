---
import { withBase } from '../../lib/base';

/**
 * The hero illustration: `public/art/hero.png`, a 160×160 pixel-art sprite of the frog exported at
 * ×2. It is transparent, so it carries the same light rim as the icons and reads on both grounds.
 * Decorative, hence `aria-hidden`. Eager, because it is above the fold.
 */
---

<img
	class="hero-art pixel"
	src={withBase('/art/hero.png')}
	width="320"
	height="320"
	alt=""
	aria-hidden="true"
	decoding="async"
	loading="eager"
/>

<style>
	/* Fills the column and scales with it; the cap is on the wrapper in `Hero.astro`. */
	.hero-art {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
