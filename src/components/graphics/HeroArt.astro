---
import { withBase } from '../../lib/base';

/**
 * The hero illustration: `public/art/hero.png`, a 160×120 pixel-art pond scene exported at ×4. It
 * paints its own background inside a dark frame, so it needs no token fills and reads on both
 * grounds. Decorative, hence `aria-hidden`. Eager, because it is above the fold.
 */
---

<img
	class="hero-art pixel"
	src={withBase('/art/hero.png')}
	width="640"
	height="480"
	alt=""
	aria-hidden="true"
	decoding="async"
	loading="eager"
/>

<style>
	/* Fills the column and scales with it; the cap is on the wrapper in `Hero.astro`. Square corners:
	   a radius would cut the frame's own pixels. */
	.hero-art {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
