---
/**
 * The hero illustration. A tree frog crouched on the near rim of a lily pad, low and right in a lit
 * disc, twisted back over its shoulder at the headline: shoulders away, head back, and a dorsal
 * stripe running across the visible back to say which way the body is turned. Three planes — the
 * disc wash, the water with the pad's mass hanging below it, and one leaf at 1.35× the frog cropped
 * by the left edge. Cut-paper flat: every form is a base shape with a shade copy offset down-right
 * under one light from the upper left, no outlines, no gradient but the wash. Every fill is an
 * `--art-*` token, so the scene recolours between light and dark. Decorative, hence `aria-hidden`.
 */
---

<svg class="hero-art" viewBox="0 0 320 280" aria-hidden="true" focusable="false">
	<defs>
		{/* The scene's only gradient: the lit disc behind everything, brightest at the light's corner. */}
		<radialGradient id="hero-wash" cx="32%" cy="24%" r="82%">
			<stop offset="0" stop-color="var(--art-disc-core)"></stop>
			<stop offset="1" stop-color="var(--art-disc)"></stop>
		</radialGradient>
		{/* The far cheek is painted inside this, so the plane that turns out of the light stops at
		    the head's own edge. */}
		{/* Everything below the surface is painted inside this, so the scene has one silhouette: a lit
		    disc with sky in its upper part and water in its lower. */}
		<clipPath id="hero-disc"><circle cx="172" cy="104" r="148"></circle></clipPath>
		<clipPath id="hero-head">
			<ellipse cx="178" cy="124" rx="45" ry="26" transform="rotate(-13 178 124)"></ellipse>
		</clipPath>
		<clipPath id="hero-lid-near"><circle cx="149" cy="103" r="13.6"></circle></clipPath>
		<clipPath id="hero-lid-far"><circle cx="186" cy="95" r="12.1"></circle></clipPath>
	</defs>

	{/* Plane 1 — the wash, cropped by the top edge so the scene starts outside the frame. */}
	<circle cx="172" cy="104" r="148" fill="url(#hero-wash)"></circle>
	<circle cx="172" cy="104" r="146.5" fill="none" stroke="var(--art-disc-edge)" stroke-width="3"></circle>

	{/* Plane 2 — the water, and the pad's mass hanging below the surface: the depth the pad floats on. */}
	<g clip-path="url(#hero-disc)">
		<path d="M 20 172 H 360 V 300 H 20 Z" fill="var(--art-water)"></path>
		<ellipse cx="206" cy="212" rx="64" ry="22" fill="var(--art-shade)"></ellipse>
		<path
			d="M 202 212 C 204 226 206 234 210 244"
			fill="none"
			stroke="var(--art-shade)"
			stroke-width="8"
			stroke-linecap="round"></path>
		{/* Catchlights on the surface, in pairs, so the water reads as a surface and not as a slab. */}
		<g fill="none" stroke="var(--art-disc-edge)" stroke-width="3" stroke-linecap="round">
			<path d="M 62 188 Q 80 183 98 188"></path>
			<path d="M 72 197 Q 84 194 96 197"></path>
			<path d="M 138 246 Q 158 241 178 246"></path>
			<path d="M 148 256 Q 162 253 176 256"></path>
		</g>
		{/* The one warm accent in the scene: the light that gets past the pad and grazes the mass
		    hanging under it. Nowhere near a tenth of the picture, and never on skin. */}
		<path
			d="M 150 224 Q 192 234 232 222"
			fill="none"
			stroke="var(--art-warm)"
			stroke-width="5"
			stroke-linecap="round"></path>
	</g>

	{/* The pad, cropped by the right edge. Shade copy first, base offset up-left over it, so the
	    crescent always lands lower-right — the rule every form in the set follows. */}
	<ellipse cx="210" cy="200" rx="82" ry="21" fill="var(--art-leaf)"></ellipse>
	<ellipse cx="206" cy="196" rx="82" ry="21" fill="var(--art-leaf-light)"></ellipse>
	<g fill="none" stroke="var(--art-leaf)" stroke-width="3" stroke-linecap="round">
		<path d="M 206 196 L 136 192"></path>
		<path d="M 206 196 L 148 206"></path>
	</g>

	{/* Contact shadows: one light, so both are the same ellipse pushed down and right. */}
	<g fill="var(--art-shade)" opacity="0.35">
		<ellipse cx="238" cy="199" rx="40" ry="8.5"></ellipse>
		<ellipse cx="146" cy="201" rx="17" ry="6"></ellipse>
	</g>

	{/* The frog, scaled about its hips so it fills about 62% of the disc's height in frame. Its own
	    coordinates are the ones every other asset shares, so the character cannot drift. */}
	<g transform="translate(-48 -26) scale(1.1)">
		{/* The far leg, one step down the ramp so it reads as behind the near side. */}
		<g fill="var(--art-frog-dark)">
			<ellipse cx="284" cy="202" rx="14" ry="8" transform="rotate(12 284 202)"></ellipse>
			<circle cx="296" cy="199" r="5.2"></circle>
			<circle cx="298" cy="207" r="5.2"></circle>
		</g>

		{/* The torso: one back-to-hip silhouette with one shade copy, not a chain of ellipses — the
		    unbroken top edge from the near shoulder to the rump is what makes the mass read as
		    rotating away from the head rather than as a row of humps. */}
		<path
			d="M 183 152 C 186 136 202 130 224 134 C 248 138 270 152 281 174
			   C 289 191 282 209 260 213 C 236 217 210 210 196 198 C 183 187 180 168 183 152 Z"
			fill="var(--art-shade)"></path>
		<path
			d="M 179 148 C 182 132 198 126 220 130 C 244 134 266 148 277 170
			   C 285 187 278 205 256 209 C 232 213 206 206 192 194 C 179 183 176 164 179 148 Z"
			fill="var(--art-frog)"></path>

		{/* The dorsal stripe runs along the top edge of that silhouette — a spine, not a strap across
		    the chest — and splits at the hips, which is the second thing telling the reader which way
		    the body is turned. */}
		<path
			d="M 194 132 C 218 126 248 140 272 164 L 265 173 C 244 152 218 138 196 143 Z"
			fill="var(--art-shade)"></path>
		<path d="M 268 166 C 275 174 279 182 280 190 L 271 192 C 270 184 266 177 260 171 Z" fill="var(--art-shade)"></path>
		<path d="M 262 171 C 265 180 265 188 263 195 L 254 192 C 256 185 256 178 254 172 Z" fill="var(--art-shade)"></path>

		{/* Rear foot on the pad: a mitten mass with three sticky pads, the front one over the rim. */}
		<ellipse cx="256" cy="203" rx="23" ry="10" transform="rotate(6 256 203)" fill="var(--art-frog-dark)"></ellipse>
		<g fill="var(--art-frog)">
			<circle cx="237" cy="206" r="6.8"></circle>
			<circle cx="249" cy="211" r="6.8"></circle>
			<circle cx="261" cy="211" r="6.8"></circle>
		</g>

		{/* Throat: the one pale form on the animal, and the reason the turned head has a near side. */}
		<ellipse cx="168" cy="150" rx="20" ry="12" transform="rotate(-14 168 150)" fill="var(--art-belly)"></ellipse>

		{/* The head: wider than the body, shorter than it, swung up and back over the near shoulder. */}
		<ellipse cx="182" cy="128" rx="45" ry="26" transform="rotate(-13 182 128)" fill="var(--art-shade)"></ellipse>
		<ellipse cx="178" cy="124" rx="45" ry="26" transform="rotate(-13 178 124)" fill="var(--art-frog)"></ellipse>
		{/* The far cheek: one curved terminator down the head, with both eyes gathered onto the near side
		    of it — that empty cheek is what turns the face three-quarter. */}
		<g clip-path="url(#hero-head)">
			<path d="M 196 84 C 218 102 222 130 210 166 L 246 166 L 246 84 Z" fill="var(--art-shade)"></path>
			<ellipse cx="152" cy="106" rx="24" ry="8" transform="rotate(-22 152 106)" fill="var(--art-frog-light)"></ellipse>
		</g>

		{/* Where the stripe starts: between the eyes, on the skull itself. */}
		<path
			d="M 167 100 C 172 108 177 116 181 123"
			fill="none"
			stroke="var(--art-shade)"
			stroke-width="5"
			stroke-linecap="round"></path>

		{/* Two turrets rising out of the skull — the skull's top edge passes behind them. The near one is
		    8% larger and breaks the head's left edge, so the pair is never matched. */}
		<circle cx="188" cy="97" r="15.2" fill="var(--art-shade)"></circle>
		<circle cx="186" cy="95" r="15.2" fill="var(--art-frog)"></circle>
		<circle cx="152" cy="105" r="16.8" fill="var(--art-shade)"></circle>
		<circle cx="149" cy="102" r="16.8" fill="var(--art-frog)"></circle>

		<circle cx="186.7" cy="95.7" r="12.1" fill="var(--art-eye-dark)"></circle>
		<circle cx="185.5" cy="94.5" r="10.2" fill="var(--art-eye)"></circle>
		<circle cx="150.7" cy="103.7" r="13.4" fill="var(--art-eye-dark)"></circle>
		<circle cx="149.5" cy="102.5" r="11.4" fill="var(--art-eye)"></circle>

		{/* The pupil is a horizontal bar in both eyes — never a disc, never vertical — and half the
		    amber's width, so amber shows on all four sides. Both bars sit a quarter of the eye's radius
		    towards the headline and tilt to it: that offset is the gaze. */}
		<rect
			x="177.8"
			y="91.1"
			width="10.2"
			height="4.6"
			rx="2.3"
			transform="rotate(-12 182.9 93.4)"
			fill="var(--art-ink)"></rect>
		<rect
			x="140.9"
			y="98.8"
			width="11.5"
			height="5"
			rx="2.5"
			transform="rotate(-12 146.65 101.3)"
			fill="var(--art-ink)"></rect>
		<circle cx="178.6" cy="89.6" r="2.4" fill="var(--art-shine)"></circle>
		<circle cx="141.4" cy="97" r="2.8" fill="var(--art-shine)"></circle>

		{/* Lids park above the eye and drop through it on the blink cycle. */}
		<g clip-path="url(#hero-lid-far)">
			<circle class="lid" cx="186" cy="95" r="13" fill="var(--art-frog)"></circle>
		</g>
		<g clip-path="url(#hero-lid-near)">
			<circle class="lid" cx="149" cy="102" r="14" fill="var(--art-frog)"></circle>
		</g>

		{/* Nostrils sit on the snout, the far one smaller: the head is turned, so its far side is short. */}
		<g fill="var(--art-ink)">
			<ellipse cx="145" cy="118" rx="3.1" ry="2.3"></ellipse>
			<ellipse cx="156" cy="114" rx="2.3" ry="1.7"></ellipse>
		</g>
		{/* One short asymmetric line off the snout, higher on the near side: attentive, not a smile. */}
		<path
			d="M 140 127 C 148 137 158 141 172 140"
			fill="none"
			stroke="var(--art-shade)"
			stroke-width="5"
			stroke-linecap="round"></path>

		{/* The near arm reaching down to the pad's front rim; the middle pad hooks over the edge, so the
		    frog is in contact with the scene rather than floating on it. */}
		<path
			d="M 190 140 C 180 164 173 188 178 206 L 162 208 C 158 188 164 162 176 138 Z"
			fill="var(--art-frog)"></path>
		<path
			d="M 190 140 C 180 164 173 188 178 206 L 171 207 C 167 188 173 162 183 139 Z"
			fill="var(--art-shade)"></path>
		<ellipse cx="177" cy="206" rx="13" ry="8" transform="rotate(-8 177 206)" fill="var(--art-shade)"></ellipse>
		<ellipse cx="174" cy="203" rx="13" ry="8" transform="rotate(-8 174 203)" fill="var(--art-frog)"></ellipse>
		<g fill="var(--art-frog-light)">
			<circle cx="164" cy="206" r="5.6"></circle>
			<circle cx="174" cy="211" r="5.6"></circle>
			<circle cx="185" cy="207" r="5.6"></circle>
		</g>
	</g>

	{/* Plane 3 — one leaf at about 1.35× the frog, cropped by the left and bottom edges. It is the
	    darkest mass in the scene: nearest the reader is furthest from the light. */}
	<g class="sway">
		<ellipse cx="18" cy="244" rx="108" ry="42" transform="rotate(-10 18 244)" fill="var(--art-shade)"></ellipse>
		<ellipse cx="14" cy="240" rx="108" ry="42" transform="rotate(-10 14 240)" fill="var(--art-leaf)"></ellipse>
		<ellipse cx="-14" cy="212" rx="48" ry="10" transform="rotate(-14 -14 212)" fill="var(--art-leaf-light)"></ellipse>
		<g fill="none" stroke="var(--art-leaf)" stroke-width="3" stroke-linecap="round">
			<path d="M -26 242 L 74 256"></path>
			<path d="M -26 242 L 92 234"></path>
			<path d="M -26 242 L 44 274"></path>
		</g>
	</g>
</svg>

<style>
	/* The wrapper in Hero.astro owns the width; the art fills it. Nothing overflows: the water and
	   the foreground leaf run past the viewBox so the frame cuts them, which is the crop the scene
	   is built on. */
	.hero-art {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Parked above the eye for most of the cycle, so the frog is open-eyed by default. */
	.lid {
		transform: translateY(-40px);
		animation: blink 7s ease-in-out infinite;
	}

	/* The foreground leaf pivots about its own stem, off the left edge, not about the scene centre. */
	.sway {
		transform-origin: -20px 240px;
		animation: sway 9s ease-in-out infinite;
	}

	@keyframes blink {
		0%,
		92%,
		100% {
			transform: translateY(-40px);
		}
		95.5% {
			transform: translateY(0);
		}
	}

	@keyframes sway {
		50% {
			transform: rotate(1.2deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lid,
		.sway {
			animation: none;
		}
	}
</style>
