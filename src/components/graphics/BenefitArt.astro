<style>
	/* The wrapper owns the width; the illustration fills it and keeps its landscape ratio. */
	.benefit-art {
		display: block;
		width: 100%;
		height: auto;
	}

	/* One moving element per scene, transforms only. The transform lives on an inner element in every
	   case, so the animated group's CSS transform composes with it instead of replacing it. */
	.hop {
		animation: hop 3.6s ease-in-out infinite;
	}

	.reject {
		animation: reject 3s ease-in-out infinite;
	}

	.steam {
		animation: steam 4s ease-in-out infinite;
	}

	.sync {
		animation: sync 3.6s ease-in-out infinite;
	}

	.lift {
		animation: lift 4.2s ease-in-out infinite;
	}

	/* The last of the push-off: the hind foot leaves the leaf and the whole frog goes up the arc. */
	@keyframes hop {
		0%,
		100% {
			transform: translate(0, 0);
		}
		55% {
			transform: translate(6px, -5px);
		}
	}

	/* Into the gate and straight back off it: the wrong shape never gets through. */
	@keyframes reject {
		0%,
		100% {
			transform: translate(0, 0);
		}
		35% {
			transform: translate(5px, -3px);
		}
	}

	/* Air off the submerged mass, rising and gone. */
	@keyframes steam {
		0%,
		100% {
			transform: translateY(4px);
		}
		50% {
			transform: translateY(-6px);
		}
	}

	/* All three lines on one timeline: the children start and finish together. */
	@keyframes sync {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-3px);
		}
	}

	@keyframes lift {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-3px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hop,
		.reject,
		.steam,
		.sync,
		.lift {
			animation: none;
		}
	}
</style>
