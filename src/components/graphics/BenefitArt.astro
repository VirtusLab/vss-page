---
/**
 * One illustration per benefit, keyed by the benefit id: five 240×180 cut-paper scenes, each a
 * picture rather than a diagram — a background wash, the frog in a pose only that scene uses, and a
 * near form cropped by the frame. Light is one source, upper left, so every form carries its shade
 * shape lower-right and everything resting on a surface drops the same contact ellipse. Limbs are
 * masses, not lines; the only strokes are things that really are lines, at the scene scale's three
 * steps, 2 / 3.2 / 5. Every fill is a token, so the set recolours between light and dark.
 * Decorative, hence `aria-hidden`.
 */
interface Props {
	/** A benefit id. An id with no illustration fails the build. */
	name: string;
}

const { name } = Astro.props;
const drawn = ['direct-style', 'type-safety', 'mature-platform', 'structured-concurrency', 'no-lock-in'];
if (!drawn.includes(name)) throw new Error(`No benefit illustration drawn for "${name}"`);

// Ids are scoped by scene name because all five scenes render on one page.
const frame = `${name}-frame`;
const eye = `${name}-eye`;
const hand = `${name}-hand`;

/* Where the pupil bar sits inside the eye. One direction per scene, both eyes on it, which is what
   points the frog's attention at the thing the scene is about. */
const gaze: Record<string, [number, number]> = {
	'direct-style': [2.4, -1],
	'type-safety': [-2.4, -2],
	'mature-platform': [-2.4, 1.4],
	'structured-concurrency': [2.4, 1.4],
	'no-lock-in': [-2.4, -1.2],
};
const [gx, gy] = gaze[name];

// no-lock-in: the front top-left corner of every block left standing. The gap is the missing 116.
const slots = [16, 66, 166, 216];
---

<svg class="benefit-art" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
	<defs>
		{/* The scene's edge: every crop in it is this rectangle cutting the drawing. */}
		<clipPath id={frame}>
			<rect width="240" height="180" rx="12"></rect>
		</clipPath>

		{/* One eye turret, drawn about its own centre and placed twice — near at full size out on the
		    head's edge, far at 0.9 near its middle, so the pair never matches and the head turns. The
		    pupil is half the amber's width, so amber shows on all four sides of the bar. */}
		<g id={eye}>
			<circle r="8.6" fill="var(--art-shade)"></circle>
			<circle cx="-1.1" cy="-1.1" r="8.6" fill="var(--art-frog)"></circle>
			<circle r="7" fill="var(--art-eye-dark)"></circle>
			<circle cx="-0.85" cy="-0.85" r="7" fill="var(--art-eye)"></circle>
			<rect x={gx - 3.5} y={gy - 1.5} width="7" height="3" rx="1.5" fill="var(--art-ink)"></rect>
			<circle cx="-3.6" cy="-4.2" r="1.8" fill="var(--art-shine)"></circle>
		</g>

		{/* A mitten with three pads, pads pointing +x; every placement turns it so one pad lands on
		    something in the scene. */}
		<g id={hand}>
			<ellipse cx="0.8" cy="0.8" rx="6.4" ry="5" fill="var(--art-shade)"></ellipse>
			<ellipse rx="6.4" ry="5" fill="var(--art-frog)"></ellipse>
			<circle cx="5.6" cy="-3.6" r="2.5" fill="var(--art-frog-light)"></circle>
			<circle cx="7.6" cy="0.8" r="2.5" fill="var(--art-frog-light)"></circle>
			<circle cx="4.6" cy="4.8" r="2.5" fill="var(--art-frog-light)"></circle>
		</g>

		{
			name === 'structured-concurrency' && (
				/* A child frog: the same build at a third the height — head 1.15× the body's width and
				   0.8 its height — and fills only, so each placement can scale and tilt it. */
				<g id={`${name}-tot`}>
					<ellipse cx="0" cy="-6" rx="9" ry="7" fill="var(--art-shade)" />
					<ellipse cx="-1.4" cy="-7.4" rx="9" ry="7" fill="var(--art-frog)" />
					<ellipse cx="3.4" cy="-4.6" rx="4.4" ry="3" fill="var(--art-belly)" />
					<ellipse cx="2" cy="-16" rx="10.35" ry="5.6" fill="var(--art-shade)" />
					<ellipse cx="0.6" cy="-17.4" rx="10.35" ry="5.6" fill="var(--art-frog)" />
					<circle cx="0.6" cy="-22.4" r="4" fill="var(--art-shade)" />
					<circle cx="-0.2" cy="-23.2" r="4" fill="var(--art-frog)" />
					<circle cx="0.4" cy="-22.8" r="2.9" fill="var(--art-eye)" />
					<rect x="-1" y="-23.6" width="2.9" height="1.6" rx="0.8" fill="var(--art-ink)" />
					<circle cx="7.4" cy="-21" r="4.6" fill="var(--art-shade)" />
					<circle cx="6.6" cy="-21.8" r="4.6" fill="var(--art-frog)" />
					<circle cx="7.4" cy="-21.4" r="3.4" fill="var(--art-eye)" />
					<rect x="6" y="-22.3" width="3.4" height="1.8" rx="0.9" fill="var(--art-ink)" />
				</g>
			)
		}

		{
			name === 'no-lock-in' && (
				/* One block of the row, seen three-quarter: lit top, base front, shaded right cheek. Its
				   origin is the front top-left corner, so a slot is just an x. */
				<g id={`${name}-block`}>
					<path d="M 0 0 L 12 -10 L 56 -10 L 44 0 Z" fill="var(--art-leaf-light)" />
					<path d="M 44 0 L 56 -10 L 56 48 L 44 58 Z" fill="var(--art-shade)" />
					<rect width="44" height="58" fill="var(--art-leaf)" />
				</g>
			)
		}
	</defs>

	{
		/* Direct style: the frog is in the air on one clean arc to the next pad, hind foot still on the
		   leaf it pushed off; the route it did not take hangs behind it as a knot of rope. */
		name === 'direct-style' && (
			<g clip-path={`url(#${frame})`}>
				<rect width="240" height="180" rx="12" fill="var(--art-disc-core)" />
				<ellipse cx="184" cy="14" rx="106" ry="68" fill="var(--art-disc)" />
				<path
					d="M -12 112 C 20 112 28 82 8 74 C -12 66 -8 42 14 40 C 38 38 44 72 66 68 C 84 65 80 38 58 42 C 34 47 42 84 68 92"
					fill="none"
					stroke="var(--art-grey)"
					stroke-width="5"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
				<rect y="118" width="240" height="62" fill="var(--art-water)" />
				<rect y="115" width="240" height="3" fill="var(--art-disc-edge)" />
				<path
					d="M 14 120 C 34 20 134 4 200 132"
					fill="none"
					stroke="var(--art-leaf-light)"
					stroke-width="3.2"
					stroke-linecap="round"
				/>
				<ellipse cx="6" cy="128" rx="54" ry="13" fill="var(--art-leaf)" />
				<ellipse cx="4" cy="125" rx="50" ry="11" fill="var(--art-leaf-light)" />
				<ellipse cx="206" cy="142" rx="54" ry="13" fill="var(--art-leaf)" />
				<ellipse cx="204" cy="139" rx="50" ry="11" fill="var(--art-leaf-light)" />
				{/* The one warm note: a bud open on the pad it is aimed at, lit at its core. */}
				<ellipse cx="200" cy="132" rx="9" ry="3.4" fill="var(--art-shade)" />
				<ellipse cx="198" cy="130" rx="9" ry="3.4" fill="var(--art-leaf)" />
				<path d="M 198 106 C 210 117 209 130 198 130 C 187 130 186 117 198 106 Z" fill="var(--art-warm)" />
				<ellipse cx="194" cy="119" rx="3" ry="5.4" transform="rotate(-14 194 119)" fill="var(--art-shine)" />
				<ellipse cx="118" cy="142" rx="26" ry="6" fill="var(--art-shade)" opacity="0.35" />
				<g class="hop">
					<g transform="translate(100 104) rotate(-16)">
						<ellipse cx="6" cy="-22" rx="8" ry="3.6" transform="rotate(30 6 -22)" fill="var(--art-frog-dark)" />
						<use href={`#${hand}`} transform="translate(12 -17) rotate(35) scale(0.85)" />
						{/* The hind leg: one tapered limb from the hip to the ankle, not a chain of beads. */}
						<path
							d="M -10.4 -18.4 C -21 -15 -31 -8 -46 1.8 C -47 4 -44.5 8 -43 8.2 C -30.5 3 -18.5 -1 -4.6 -5.6 Z"
							fill="var(--art-shade)"
						/>
						<path
							d="M -11.9 -20.4 C -22.5 -17 -32.5 -10 -47.5 -0.2 C -48.5 2 -46 6 -44.5 6.2 C -32 1 -20 -3 -6.1 -7.6 Z"
							fill="var(--art-frog-dark)"
						/>
						<ellipse cx="-9" cy="-14" rx="11" ry="10" fill="var(--art-shade)" />
						<ellipse cx="-11" cy="-16" rx="11" ry="10" fill="var(--art-frog-dark)" />
						<use href={`#${hand}`} transform="translate(-46 3) rotate(200) scale(1.15)" />
						<ellipse cx="0" cy="-17" rx="14.5" ry="12.5" fill="var(--art-shade)" />
						<ellipse cx="-2" cy="-19" rx="14.5" ry="12.5" fill="var(--art-frog)" />
						<ellipse cx="6" cy="-13" rx="8" ry="6" fill="var(--art-belly)" />
						<ellipse cx="-9" cy="-27" rx="7" ry="3.2" transform="rotate(-24 -9 -27)" fill="var(--art-frog-light)" />
						<ellipse cx="4" cy="-34" rx="16.7" ry="10" fill="var(--art-shade)" />
						<ellipse cx="2" cy="-36" rx="16.7" ry="10" fill="var(--art-frog)" />
						<ellipse cx="8" cy="-30" rx="7.5" ry="3.6" fill="var(--art-belly)" />
						<ellipse cx="-6" cy="-42" rx="6" ry="2.6" transform="rotate(-16 -6 -42)" fill="var(--art-frog-light)" />
						<path
							d="M 4 -45 C -3 -38 -9 -30 -11 -23"
							fill="none"
							stroke="var(--art-shade)"
							stroke-width="3.2"
							stroke-linecap="round"
						/>
						<path
							d="M -11 -23 C -13 -19 -15 -16 -17 -14 M -11 -23 C -10 -18 -11 -15 -9 -12"
							fill="none"
							stroke="var(--art-shade)"
							stroke-width="2"
							stroke-linecap="round"
						/>
						<circle cx="15" cy="-37.5" r="1" fill="var(--art-ink)" />
						<circle cx="10" cy="-39" r="1" fill="var(--art-ink)" />
						<path
							d="M 18 -32 Q 12 -26 4 -29"
							fill="none"
							stroke="var(--art-shade)"
							stroke-width="2"
							stroke-linecap="round"
						/>
						<use href={`#${eye}`} transform="translate(2 -47) scale(0.9)" />
						<use href={`#${eye}`} transform="translate(13 -45)" />
						<ellipse cx="14" cy="-19" rx="9" ry="4" transform="rotate(35 14 -19)" fill="var(--art-frog)" />
						<use href={`#${hand}`} transform="translate(21 -13) rotate(40)" />
					</g>
				</g>
				<path d="M -12 186 C 14 146 74 132 122 148 C 92 180 34 194 -12 186 Z" fill="var(--art-shade)" />
				<path d="M -14 183 C 12 143 72 129 120 145 C 90 177 32 191 -14 183 Z" fill="var(--art-leaf)" />
				<path
					d="M -6 176 C 24 150 70 142 108 150"
					fill="none"
					stroke="var(--art-leaf-light)"
					stroke-width="3.2"
					stroke-linecap="round"
				/>
			</g>
		)
	}

	{
		/* Types: a square peg, tilted off the line it came in on, drives into the leaf gate and springs
		   off it; the round piece that fits is already seated in the round slot with the light behind
		   it, and the frog has the next round one under its hand. */
		name === 'type-safety' && (
			<g clip-path={`url(#${frame})`}>
				<rect width="240" height="180" rx="12" fill="var(--art-disc-core)" />
				<ellipse cx="196" cy="26" rx="94" ry="62" fill="var(--art-disc)" />
				{/* The light behind the gate, with a lit core: a flat fill alone cannot read as light. */}
				<circle cx="76" cy="96" r="16.5" fill="var(--art-warm)" />
				<circle cx="68" cy="88" r="5" fill="var(--art-shine)" />
				{/* The piece that fits, seen from behind, seated in the slot. */}
				<circle cx="80" cy="105" r="13" fill="var(--art-shade)" />
				<circle cx="78" cy="103" r="13" fill="var(--art-leaf-light)" />
				<path
					d="M 61 -12 C 41 30 41 100 79 150 C 115 100 115 30 95 -12 Z M 96 99 A 17 17 0 1 1 62 99 A 17 17 0 1 1 96 99 Z"
					fill-rule="evenodd"
					fill="var(--art-shade)"
				/>
				<path
					d="M 58 -15 C 38 27 38 97 76 147 C 112 97 112 27 92 -15 Z M 93 96 A 17 17 0 1 1 59 96 A 17 17 0 1 1 93 96 Z"
					fill-rule="evenodd"
					fill="var(--art-leaf)"
				/>
				<path
					d="M 73 -14 C 62 24 61 50 63 74"
					fill="none"
					stroke="var(--art-leaf-light)"
					stroke-width="3.2"
					stroke-linecap="round"
				/>
				{/* The bank the gate stands in and the frog sits on. */}
				<path d="M -6 152 L 246 142 L 246 186 L -6 186 Z" fill="var(--art-shade)" />
				<path d="M -6 148 L 246 138 L 246 158 L -6 168 Z" fill="var(--art-leaf)" />
				<path d="M -6 148 L 246 138 L 246 144 L -6 154 Z" fill="var(--art-leaf-light)" />
				<ellipse cx="86" cy="150" rx="28" ry="6" fill="var(--art-shade)" opacity="0.35" />
				{/* The next round piece, waiting under the frog's hand. */}
				<ellipse cx="158" cy="141" rx="13" ry="3.5" fill="var(--art-shade)" opacity="0.35" />
				<circle cx="154" cy="133" r="10.5" fill="var(--art-shade)" />
				<circle cx="152" cy="131" r="10.5" fill="var(--art-leaf-light)" />
				<ellipse cx="196" cy="143" rx="24" ry="5.5" fill="var(--art-shade)" opacity="0.35" />
				<g transform="translate(188 141)">
					<ellipse cx="-6" cy="-22" rx="7.5" ry="3.6" transform="rotate(-30 -6 -22)" fill="var(--art-frog-dark)" />
					<use href={`#${hand}`} transform="translate(-12 -18) rotate(200) scale(0.85)" />
					<ellipse cx="9" cy="-14" rx="11" ry="10" fill="var(--art-shade)" />
					<ellipse cx="7" cy="-16" rx="11" ry="10" fill="var(--art-frog-dark)" />
					<ellipse cx="9" cy="-5" rx="8.5" ry="4.6" transform="rotate(28 9 -5)" fill="var(--art-frog-dark)" />
					<use href={`#${hand}`} transform="translate(2 -2) rotate(170) scale(1.15)" />
					<ellipse cx="0" cy="-17" rx="14.5" ry="12.5" fill="var(--art-shade)" />
					<ellipse cx="-2" cy="-19" rx="14.5" ry="12.5" fill="var(--art-frog)" />
					<ellipse cx="-6" cy="-13" rx="8" ry="6" fill="var(--art-belly)" />
					<ellipse cx="-9" cy="-27" rx="7" ry="3.2" transform="rotate(-24 -9 -27)" fill="var(--art-frog-light)" />
					<ellipse cx="-4" cy="-34" rx="16.7" ry="10" fill="var(--art-shade)" />
					<ellipse cx="-6" cy="-36" rx="16.7" ry="10" fill="var(--art-frog)" />
					<ellipse cx="-8" cy="-30" rx="7.5" ry="3.6" fill="var(--art-belly)" />
					<ellipse cx="-14" cy="-42" rx="6" ry="2.6" transform="rotate(-16 -14 -42)" fill="var(--art-frog-light)" />
					<path
						d="M -4 -45 C 3 -38 9 -30 11 -23"
						fill="none"
						stroke="var(--art-shade)"
						stroke-width="3.2"
						stroke-linecap="round"
					/>
					<path
						d="M 11 -23 C 13 -19 15 -16 17 -14 M 11 -23 C 10 -18 11 -15 9 -12"
						fill="none"
						stroke="var(--art-shade)"
						stroke-width="2"
						stroke-linecap="round"
					/>
					<circle cx="-15" cy="-37.5" r="1" fill="var(--art-ink)" />
					<circle cx="-10" cy="-39" r="1" fill="var(--art-ink)" />
					<path
						d="M -18 -32 Q -12 -26 -4 -29"
						fill="none"
						stroke="var(--art-shade)"
						stroke-width="2"
						stroke-linecap="round"
					/>
					<use href={`#${eye}`} transform="translate(-2 -47) scale(0.9)" />
					<use href={`#${eye}`} transform="translate(-13 -45)" />
					{/* Upper arm and forearm, bent at the elbow, one pad flat on the piece. */}
					<ellipse cx="-13.5" cy="-26" rx="6.5" ry="4" transform="rotate(10 -13.5 -26)" fill="var(--art-frog)" />
					<ellipse cx="-22.5" cy="-25" rx="5" ry="3.6" transform="rotate(150 -22.5 -25)" fill="var(--art-frog)" />
					<use href={`#${hand}`} transform="translate(-27 -22) rotate(200)" />
				</g>
				{/* The shock the hit springs off the gate, radiating from the contact point. */}
				<g fill="none" stroke="var(--art-shade)" stroke-linecap="round">
					<path d="M 91 44 L 82 44" stroke-width="3.2" />
					<path d="M 93.8 51.7 L 86.9 57.5" stroke-width="2" />
					<path d="M 100.9 55.8 L 99.3 64.7" stroke-width="2" />
					<path d="M 93.8 36.3 L 86.9 30.5" stroke-width="2" />
					<path d="M 100.9 32.2 L 99.3 23.3" stroke-width="2" />
				</g>
				{/* The wrong shape, near and large: a square peg, and it is not even square to its line. */}
				<g class="reject">
					<rect
						x="108"
						y="34"
						width="22"
						height="22"
						rx="3"
						transform="rotate(37 119 45)"
						fill="var(--art-shade)"
					/>
					<rect
						x="105"
						y="31"
						width="22"
						height="22"
						rx="3"
						transform="rotate(37 116 42)"
						fill="var(--art-grey)"
					/>
					<rect
						x="118"
						y="-6"
						width="78"
						height="54"
						rx="10"
						transform="rotate(22 157 21)"
						fill="var(--art-shade)"
					/>
					<rect
						x="115"
						y="-9"
						width="78"
						height="54"
						rx="10"
						transform="rotate(22 154 18)"
						fill="var(--art-grey)"
					/>
				</g>
			</g>
		)
	}

	{
		/* A mature platform: the deck the frog sits on is the small part — the pier's bulk runs on down
		   through the water, past the bottom of the frame. */
		name === 'mature-platform' && (
			<g clip-path={`url(#${frame})`}>
				<rect width="240" height="180" rx="12" fill="var(--art-disc-core)" />
				<ellipse cx="52" cy="8" rx="112" ry="60" fill="var(--art-disc)" />
				<rect y="100" width="240" height="80" fill="var(--art-water)" />
				<rect y="97" width="240" height="3" fill="var(--art-disc-edge)" />
				{/* The mass below the surface: one form, banded by the water passing in front of it. */}
				<path d="M 98 100 L 236 100 L 248 186 L 84 186 Z" fill="var(--art-shade)" />
				<path d="M 86 122 L 244 122 L 246 128 L 85 128 Z" fill="var(--art-water)" />
				<path d="M 84 154 L 248 154 L 249 159 L 83 159 Z" fill="var(--art-water)" />
				<g class="steam" fill="var(--art-disc-edge)">
					<circle cx="128" cy="152" r="4.4" />
					<circle cx="133" cy="136" r="3.2" />
					<circle cx="127" cy="120" r="2.2" />
				</g>
				{/* The pier above the water: front face, its shaded foot, and the lit deck. */}
				<path d="M 94 80 L 240 72 L 240 100 L 94 100 Z" fill="var(--art-leaf)" />
				<path d="M 94 90 L 240 82 L 240 100 L 94 100 Z" fill="var(--art-shade)" />
				<path d="M 94 64 L 240 56 L 240 72 L 94 80 Z" fill="var(--art-leaf-light)" />
				{/* The lantern at the deck's far end: the scene's one warm note, lit at its core. */}
				<rect x="102" y="34" width="5" height="30" fill="var(--art-frog-dark)" />
				<path d="M 97 18 L 112 18 L 116 34 L 93 34 Z" fill="var(--art-warm)" />
				<path d="M 101 23 L 108 23 L 110 30 L 99 30 Z" fill="var(--art-shine)" />
				<rect x="94" y="14" width="21" height="5" rx="2.5" fill="var(--art-frog-dark)" />
				<ellipse cx="188" cy="74" rx="24" ry="5" fill="var(--art-shade)" opacity="0.35" />
				<g transform="translate(176 72)">
					<ellipse cx="-5" cy="-20" rx="7" ry="3.6" transform="rotate(-55 -5 -20)" fill="var(--art-frog-dark)" />
					<use href={`#${hand}`} transform="translate(-8 -12) rotate(215) scale(0.85)" />
					<ellipse cx="9" cy="-14" rx="11" ry="10" fill="var(--art-shade)" />
					<ellipse cx="7" cy="-16" rx="11" ry="10" fill="var(--art-frog-dark)" />
					<ellipse cx="9" cy="-5" rx="8.5" ry="4.6" transform="rotate(28 9 -5)" fill="var(--art-frog-dark)" />
					<use href={`#${hand}`} transform="translate(2 -2) rotate(170) scale(1.15)" />
					<ellipse cx="0" cy="-17" rx="14.5" ry="12.5" fill="var(--art-shade)" />
					<ellipse cx="-2" cy="-19" rx="14.5" ry="12.5" fill="var(--art-frog)" />
					<ellipse cx="-6" cy="-13" rx="8" ry="6" fill="var(--art-belly)" />
					<ellipse cx="-9" cy="-27" rx="7" ry="3.2" transform="rotate(-24 -9 -27)" fill="var(--art-frog-light)" />
					<ellipse cx="-4" cy="-34" rx="16.7" ry="10" fill="var(--art-shade)" />
					<ellipse cx="-6" cy="-36" rx="16.7" ry="10" fill="var(--art-frog)" />
					<ellipse cx="-8" cy="-30" rx="7.5" ry="3.6" fill="var(--art-belly)" />
					<ellipse cx="-14" cy="-42" rx="6" ry="2.6" transform="rotate(-16 -14 -42)" fill="var(--art-frog-light)" />
					<path
						d="M -4 -45 C 3 -38 9 -30 11 -23"
						fill="none"
						stroke="var(--art-shade)"
						stroke-width="3.2"
						stroke-linecap="round"
					/>
					<path
						d="M 11 -23 C 13 -19 15 -16 17 -14 M 11 -23 C 10 -18 11 -15 9 -12"
						fill="none"
						stroke="var(--art-shade)"
						stroke-width="2"
