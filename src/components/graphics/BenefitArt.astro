---
import { withBase } from '../../lib/base';

/**
 * One illustration per benefit, keyed by the benefit id: `public/art/benefit-<name>.png`, a rendered
 * plate on its own cream ground, exported at 2x and shown at 320×240. Decorative, hence `aria-hidden`.
 */
interface Props {
	/** A benefit id. An id with no illustration fails the build. */
	name: string;
}

const { name } = Astro.props;
const drawn = ['direct-style', 'type-safety', 'mature-platform', 'structured-concurrency', 'no-lock-in'];
if (!drawn.includes(name)) throw new Error(`No benefit illustration drawn for "${name}"`);
---

<img
	class="benefit-art plate"
	src={withBase(`/art/benefit-${name}.png`)}
	width="320"
	height="240"
	alt=""
	aria-hidden="true"
	decoding="async"
	loading="lazy"
/>

<style>
	.benefit-art {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
