---
import { withBase } from '../../lib/base';

/**
 * One illustration per benefit, keyed by the benefit id: `public/art/benefit-<name>.png`, a 160×120
 * pixel-art scene exported at ×4 and shown at 320 wide, so every logical pixel is two device ones.
 * Each scene paints its own background inside a dark frame. Decorative, hence `aria-hidden`.
 */
interface Props {
	/** A benefit id. An id with no illustration fails the build. */
	name: string;
}

const { name } = Astro.props;
const drawn = ['direct-style', 'type-safety', 'mature-platform', 'structured-concurrency', 'no-lock-in'];
if (!drawn.includes(name)) throw new Error(`No benefit illustration drawn for "${name}"`);
---

<img
	class="benefit-art pixel"
	src={withBase(`/art/benefit-${name}.png`)}
	width="320"
	height="240"
	alt=""
	aria-hidden="true"
	decoding="async"
	loading="lazy"
/>

<style>
	/* Square corners: the scene's own frame is drawn in the image, and a radius would clip it. */
	.benefit-art {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
