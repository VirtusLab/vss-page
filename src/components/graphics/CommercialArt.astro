---
/**
 * The frog for the commercial block: the same animal as the hero and the section icons, holding an
 * amber briefcase — the one prop on the page that is not part of the open-source stack. Drawn at
 * figure size rather than icon size, so it carries detail the 48px tiles cannot.
 * Decorative, hence `aria-hidden`.
 */
---

<svg class="figure" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
	{/* Haunches only — a detached toe pad at this size reads as a stray dot, not as a foot — then the
	    same two-overlapping-ellipses body and head as the hero. */}
	<g fill="var(--art-frog-dark)">
		<ellipse cx="32" cy="82" rx="15" ry="13"></ellipse>
		<ellipse cx="88" cy="82" rx="15" ry="13"></ellipse>
	</g>
	<ellipse cx="60" cy="72" rx="32" ry="24" fill="var(--art-frog)"></ellipse>
	<ellipse cx="60" cy="46" rx="30" ry="23" fill="var(--art-frog)"></ellipse>
	<ellipse cx="60" cy="38" rx="20" ry="11" fill="var(--art-frog-light)" opacity="0.5"></ellipse>

	{/* Arms reaching down to the case handle; the case is drawn over their lower half. */}
	<g fill="var(--art-frog)">
		<rect x="23" y="56" width="13" height="32" rx="6.5" transform="rotate(9 29.5 72)"></rect>
		<rect x="84" y="56" width="13" height="32" rx="6.5" transform="rotate(-9 90.5 72)"></rect>
	</g>

	{/* Eyes and face. */}
	<circle cx="43" cy="29" r="15" fill="var(--art-frog-light)"></circle>
	<circle cx="77" cy="29" r="15" fill="var(--art-frog-light)"></circle>
	<circle cx="43" cy="29" r="10.8" fill="var(--art-eye-dark)"></circle>
	<circle cx="77" cy="29" r="10.8" fill="var(--art-eye-dark)"></circle>
	<circle cx="43" cy="29" r="8.8" fill="var(--art-eye)"></circle>
	<circle cx="77" cy="29" r="8.8" fill="var(--art-eye)"></circle>
	<ellipse cx="43" cy="29" rx="3.4" ry="5.6" fill="var(--art-ink)"></ellipse>
	<ellipse cx="77" cy="29" rx="3.4" ry="5.6" fill="var(--art-ink)"></ellipse>
	<circle cx="39.5" cy="25" r="2.8" fill="var(--art-shine)"></circle>
	<circle cx="73.5" cy="25" r="2.8" fill="var(--art-shine)"></circle>
	<g fill="var(--art-frog-dark)">
		<ellipse cx="54" cy="44" rx="2.2" ry="1.7"></ellipse>
		<ellipse cx="66" cy="44" rx="2.2" ry="1.7"></ellipse>
	</g>
	<path
		d="M 45 54 Q 60 65 75 54"
		fill="none"
		stroke="var(--art-frog-dark)"
		stroke-width="3.6"
		stroke-linecap="round"></path>

	{/* The briefcase: the one amber object, matching the block's border and eyebrow. */}
	<path
		d="M 48 80 L 48 72 Q 60 65 72 72 L 72 80"
		fill="none"
		stroke="var(--art-eye-dark)"
		stroke-width="4"
		stroke-linecap="round"></path>
	<rect x="28" y="78" width="64" height="34" rx="7" fill="var(--accent-2)"></rect>
	<rect x="28" y="78" width="64" height="5" rx="2.5" fill="var(--art-shine)" opacity="0.28"></rect>
	<rect x="54" y="88" width="12" height="9" rx="2.5" fill="var(--art-eye-dark)"></rect>

	{/* Both hands on the case's top edge, so the frog is holding it rather than standing behind it. */}
	<g fill="var(--art-frog-light)">
		<circle cx="32" cy="78" r="6.5"></circle>
		<circle cx="88" cy="78" r="6.5"></circle>
	</g>
</svg>

<style>
	.figure {
		display: block;
		flex: none;
		width: var(--figure);
		height: var(--figure);
	}
</style>
