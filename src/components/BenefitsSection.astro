---
import { render } from 'astro:content';
import type { Site } from '../lib/content';
import Promo from './Promo.astro';
import BenefitArt from './graphics/BenefitArt.astro';

/**
 * The argument for the stack, between the snippets and the components. Sits on a full-bleed
 * `--surface` band, which is what separates the page's three chapters; the band is why this is the
 * one block rendered outside the page container. The `after-benefits` promos close the chapter,
 * inside the band, so the tint carries them too.
 */
interface Props {
	benefits: Site['benefits'];
	promos: Site['promos']['afterBenefits'];
}

const { benefits, promos } = Astro.props;

// `render` is async and cannot be awaited inside the template, so the bodies are rendered up front.
const items = await Promise.all(
	benefits.items.map(async (item) => ({ ...item, Content: (await render(item.entry)).Content })),
);
---

<div class="band">
	<section id="benefits">
		<h2 class="chapter-heading">{benefits.heading}</h2>
		<p class="intro">{benefits.intro}</p>
		{/* An ordered list: the five make an argument in order, and the numerals are the CSS counter
		    on it, so the sequence is never text anyone has to keep in step. */}
		<ol class="items" role="list">
			{
				items.map(({ id, title, tagline, Content }) => (
					<li>
						<article>
							<div class="art">
								<BenefitArt name={id} />
							</div>
							<div class="text">
								<h3 id={`benefit-${id}`}>{title}</h3>
								<p class="tagline">{tagline}</p>
								<div class="body">
									<Content />
								</div>
							</div>
						</article>
					</li>
				))
			}
		</ol>
		<div class="promos">{promos.map((promo) => <Promo promo={promo} />)}</div>
	</section>
</div>

<style>
	/* Edge to edge, and the one block that paints its own ground: the tint is what tells the reader
	   a new chapter started. */
	/* The same air at both edges, and one step up from the blocks around it: the padding is the whole
	   gap between the band's rule and the chapter's first line. */
	.band {
		background: var(--surface);
		border-block: var(--border) solid var(--line);
		padding: var(--space-6) 0;
	}

	/* Rendered outside `.page`, so this is what puts the chapter back in the page's column — the cap
	   and the gutters both, or the text would start a gutter's width left of every other block. */
	section {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0 var(--space-3);
	}

	.intro {
		margin: 0;
		color: var(--muted);
	}

	.items {
		counter-reset: benefit;
		display: grid;
		gap: var(--space-5);
		margin: var(--space-5) 0 0;
		padding: 0;
		list-style: none;
	}

	.items li {
		counter-increment: benefit;
	}

	/* The band's bottom padding is the air under the last block in the chapter, so a promo closing it
	   keeps only its top gap. `:global`, because the box is another component's scoped element. */
	.promos {
		margin-top: var(--space-6);
	}

	.promos :global(section) {
		margin: 0;
	}

	.promos :global(section + section) {
		margin-top: var(--space-5);
	}

	article {
		display: grid;
		gap: var(--space-3);
	}

	/* Each scene paints its own ground inside a dark frame drawn in the image, so the wrapper adds
	   no border, no padding and no radius — a radius here would clip the frame's own pixels. */
	.art {
		width: 100%;
		max-width: 320px;
	}

	.text {
		min-width: 0;
		max-width: var(--measure);
	}

	/* The item's number, drawn from the list counter rather than written into the content. */
	.text::before {
		content: counter(benefit, decimal-leading-zero);
		display: block;
		margin-bottom: var(--space-1);
		color: var(--accent);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	h3 {
		margin: 0 0 var(--space-2);
		font-size: var(--text-lg);
	}

	.tagline {
		margin: 0 0 var(--space-2);
		font-size: var(--text-base);
		font-weight: 600;
	}

	.body {
		color: var(--muted);
	}

	/* `:global`, because the paragraphs come from <Content /> and carry no scope attribute. */
	.body :global(p) {
		margin: 0 0 var(--space-2);
	}

	.body :global(p:last-child) {
		margin-bottom: 0;
	}

	@media (min-width: 720px) {
		.items {
			gap: var(--space-6);
		}

		/* Text then illustration, in fixed columns rather than as a flex row: the text column is the
		   measure and the illustration 320px, so every row has the same gutter between the two and the
		   text starts on the heading's edge. The spare width goes between the columns, never inside
		   one, which is what would have made the gutter differ from row to row. */
		article {
			grid-template-columns: minmax(0, var(--measure)) 320px;
			justify-content: space-between;
			align-items: center;
			gap: var(--space-5);
		}

		/* The illustration is second in the DOM, where a phone wants it above the text, and second in
		   the grid too. */
		.art {
			order: 2;
			width: 320px;
		}

		/* The illustration changes sides down the column, so the five read as a sequence and not as
		   five copies of one row. The whole row is mirrored, columns and gutter alike; the children
		   are put back to `ltr`, which is only the mirroring undone. */
		.items li:nth-child(even) article {
			direction: rtl;
		}

		.items li:nth-child(even) article > * {
			direction: ltr;
		}

	}
</style>
