---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/base';

/** Who maintains the page, where its source is, the agent mirror, and the license when there is one. */
interface Props {
	footer: CollectionEntry<'footer'>['data'];
}

const { footer } = Astro.props;
// The schema guarantees exactly two, so the sentence can name them directly.
const [first, second] = footer.maintainers;
---

<footer>
	<p>Maintained by <a href={first.url}>{first.label}</a> and <a href={second.url}>{second.label}</a>.</p>
	<p class="links">
		<a href={footer.repoUrl}>{footer.repoLabel}</a>
		<a href={withBase(footer.llmsHref)}>{footer.llmsLabel}</a>
	</p>
	{footer.license && <p class="license">{footer.license}</p>}
</footer>

<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-4) 0 var(--space-6);
		border-top: 1px solid var(--border);
		font-size: var(--text-sm);
		color: var(--muted);
	}

	p {
		margin: 0;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
	}

	@media (min-width: 720px) {
		footer {
			flex-direction: row;
			justify-content: space-between;
			gap: var(--space-4);
		}
	}
</style>
