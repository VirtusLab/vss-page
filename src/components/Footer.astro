---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/base';
import PixelDivider from './graphics/PixelDivider.astro';

/** Who maintains the page, where its source is, the agent mirror, and the license when there is one. */
interface Props {
	footer: CollectionEntry<'footer'>['data'];
	labels: CollectionEntry<'labels'>['data'];
}

const { footer, labels } = Astro.props;
const { maintainers } = footer;
---

<footer>
	<PixelDivider id="footer" />
	<div class="rows">
		<p>
			Maintained by
			{maintainers.map((maintainer, i) => (
				<>
					{i === 0 ? ' ' : i === maintainers.length - 1 ? ' and ' : ', '}<a href={maintainer.url}>{maintainer.label}</a>
				</>
			))}.
		</p>
		<p class="links">
			<a href={footer.repoUrl}>{footer.repoLabel}</a>
			<a href={withBase(labels.llmsHref)}>{labels.llmsLabel}</a>
		</p>
		{footer.license && <p class="license">{footer.license}</p>}
	</div>
</footer>

<style>
	footer {
		padding-bottom: var(--space-6);
	}

	.rows {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding-top: var(--space-4);
		font-size: var(--text-sm);
		color: var(--muted);
	}

	p {
		margin: 0;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
		font-family: var(--font-display);
		font-size: var(--text-xs);
	}

	@media (min-width: 720px) {
		.rows {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: var(--space-4);
		}
	}
</style>
