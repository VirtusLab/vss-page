---
import { formatStars, type Site } from '../lib/content';
import DocsIcon from './graphics/DocsIcon.astro';
import GithubMark from './graphics/GithubMark.astro';
import SectionIcon from './graphics/SectionIcon.astro';
import StarIcon from './graphics/StarIcon.astro';

/** One stack section: a frog icon and title, then a card per component. */
interface Props {
	section: Site['sections'][number];
	labels: Site['labels'];
}

const { section, labels } = Astro.props;
---

<section id={section.id}>
	<h2 class="chapter-heading">
		<SectionIcon name={section.id} />
		<span>{section.title}</span>
	</h2>
	{/* `list-style: none` drops list semantics in Safari/VoiceOver; the role puts them back. */}
	<ul class="components" role="list">
		{
			section.components.map((component) => (
				<li class:list={['panel', !component.github && 'bandless']}>
					<div class="body">
						<h3 id={component.id}>
							{/* GitHub is the default destination; only a component without a repository sends
							    the name to its own site. */}
							<a href={component.github ?? component.url}>{component.name}</a>
						</h3>
						<p>{component.description}</p>
					</div>
					{component.github && (
						<div class="links">
							{/* The band always opens with GitHub, so the cell is in the same place on every
							    card; the docs cell appears only where the component has a site of its own. */}
							<a href={component.github}>
								<GithubMark />
								{/* The component name is hidden and the label shown, so every cell in the row
								    reads the same width while each link still names its own project. */}
								<span class="label">{`${component.name}: `}</span>
								<span>{labels.githubLabel}</span>
							</a>
							{component.docs && (
								<a href={component.docs}>
									<DocsIcon />
									<span class="label">{`${component.name}: `}</span>
									<span>{labels.docsLabel}</span>
								</a>
							)}
							{component.githubRepo && (
								<a class="stars" href={component.github}>
									<StarIcon />
									{/* Ahead of the number and part of the link's name, so the count is read out
									    as "<name> stars on GitHub: 1.5k" instead of being skipped. */}
									<span class="label">
										{component.name} {labels.starsLabel}
									</span>
									{/* Baked in when the build had a token; refreshed by the script in index.astro. */}
									<span data-stars={component.githubRepo}>
										{component.stars !== undefined && formatStars(component.stars)}
									</span>
									{/* Shown only while the count is empty, so the cell never reads as a
									    lone star icon that does nothing. */}
									<span class="pending" aria-hidden="true">{labels.starsPending}</span>
								</a>
							)}
						</div>
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	section {
		padding-top: var(--space-5);
	}

	/* Only the icon row; the size comes from the global `.chapter-heading`. The gap to the cards is
	   the grid's own margin, so the heading drops its bottom one. */
	h2 {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin-bottom: 0;
	}

	.components {
		display: grid;
		align-items: stretch;
		gap: var(--space-3);
		margin: var(--space-4) 0 0;
		padding: 0;
		list-style: none;
	}

	/* A column, so the cards in a row are as tall as the tallest and the link band still sits on
	   each one's bottom edge. `overflow: hidden` is what the band's corners are clipped by. */
	.components li {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--surface);
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease,
			border-color 0.18s ease;
	}

	.body {
		flex: 1;
		padding: var(--space-3) var(--space-4);
	}

	/* A card with no link band has nothing to align to its row-mate's band, so stretching it would
	   only leave blank space under the description. It takes its own height instead. */
	.bandless {
		align-self: start;
	}

	.components li:hover {
		transform: translateY(-3px);
		border-color: var(--accent-bright);
		box-shadow: var(--shadow-lift);
	}

	h3 {
		margin: 0 0 var(--space-1);
		font-size: var(--text-base);
	}

	.components p {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--muted);
	}

	/* The band across the card's bottom edge: a tinted strip ruled off from the body, holding the
	   links as equal cells. A card with three links and one with only a star count get the same
	   band, so the strips line up across a row. */
	.links {
		display: flex;
		border-top: var(--border) solid var(--line);
		background: var(--surface-2);
		font-size: var(--text-sm);
	}

	/* Equal cells: `flex: 1` off a zero basis, so the widths follow the cell count, not the label
	   lengths. `min-width: 0` lets a cell shrink below its label rather than overflow the card. */
	.links a {
		display: flex;
		flex: 1 1 0;
		min-width: 0;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-2);
		/* The band sits at the weight of the description above it; the name stays the one green
		   target on the card until a pointer or focus reaches a cell. */
		color: var(--muted);
		text-decoration: none;
		white-space: nowrap;
	}

	.links a + a {
		border-left: var(--border) solid var(--line);
	}

	.links a:hover,
	.links a:focus-visible {
		background: var(--surface-2-hover);
		color: var(--accent);
	}

	/* The card clips to its radius, so the global ring — drawn --border-thick outside the element —
	   would be cut off along the card's edges. The same ring, drawn inside instead. */
	.links a:focus-visible {
		outline-offset: calc(var(--border-thick) * -1);
	}

	/* Before the build's star counts arrive — or without a `GITHUB_TOKEN` at all — the count span is
	   empty, and its gap would push the star off the cell's centre. The script fills it and it shows. */
	[data-stars]:empty {
		display: none;
	}

	/* The two are alternatives: as soon as the count has text, the standing-in word goes. */
	[data-stars]:not(:empty) + .pending {
		display: none;
	}

	/* Read by screen readers, never shown: it prefixes each cell's visible label with the component
	   name, so the links are told apart out of the card's context. */
	.label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (min-width: 720px) {
		section {
			padding-top: var(--space-6);
		}

		.components {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-3);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.components li {
			transition: none;
		}

		.components li:hover {
			transform: none;
		}
	}
</style>
