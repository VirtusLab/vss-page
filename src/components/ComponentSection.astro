---
import { render } from 'astro:content';
import { formatStars, type Site } from '../lib/content';
import DocsIcon from './graphics/DocsIcon.astro';
import GithubMark from './graphics/GithubMark.astro';
import SectionIcon from './graphics/SectionIcon.astro';
import StarIcon from './graphics/StarIcon.astro';

/** One stack section: a frog icon and title, an intro paragraph, and a card per component. */
interface Props {
	section: Site['sections'][number];
	labels: Site['labels'];
}

const { section, labels } = Astro.props;
const { Content } = await render(section.intro);
---

<section id={section.id}>
	<h2>
		<SectionIcon name={section.id} />
		<span>{section.title}</span>
	</h2>
	<div class="intro"><Content /></div>
	<ul class="components">
		{
			section.components.map((component) => (
				<li class="panel">
					<h3 id={component.id}>
						{/* GitHub is the default destination; only a component without a repository sends
						    the name to its own site. */}
						<a href={component.github ?? component.url}>{component.name}</a>
					</h3>
					<p>{component.description}</p>
					{component.github && (
						<p class="links">
							{/* Two icons only where the name link alone cannot reach both destinations. */}
							{component.docs && (
								<>
									<a href={component.github}>
										<GithubMark />
										<span class="label">
											{component.name}: {labels.githubLabel}
										</span>
									</a>
									<a href={component.docs}>
										<DocsIcon />
										<span class="label">
											{component.name}: {labels.docsLabel}
										</span>
									</a>
								</>
							)}
							{component.githubRepo && (
								<a class="stars" href={component.github} title={labels.starsTitle}>
									<StarIcon />
									{/* Ahead of the number and part of the link's name, so the count is read out
									    as "<name> stars on GitHub: 1.5k" instead of being skipped. */}
									<span class="label">
										{component.name} {labels.starsLabel}
									</span>
									{/* Baked in when the build had a token; refreshed by the script in index.astro. */}
									<span data-stars={component.githubRepo}>
										{component.stars !== undefined && formatStars(component.stars)}
									</span>
								</a>
							)}
						</p>
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	section {
		padding-top: var(--space-5);
	}

	h2 {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin: 0 0 var(--space-3);
		font-size: var(--text-xl);
	}

	/* The whole intro block starts where the heading text does, past the icon column, so the rule
	   sits on the text edge instead of floating an icon's width away from it. */
	.intro {
		position: relative;
		color: var(--muted);
		margin-left: calc(var(--icon) + var(--space-3));
		padding-left: var(--space-3);
	}

	/* The bright-green rule, drawn as a rounded bar rather than a border: a pill radius on a
	   left border alone bows the edge into a crescent. */
	.intro::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: var(--rule);
		border-radius: var(--radius-pill);
		background: var(--accent-bright);
	}

	/* An intro of two paragraphs keeps the same rhythm as a one-paragraph one. `:global`, because
	   the paragraphs come from <Content /> and carry no scope attribute. */
	.intro :global(p) {
		margin: 0 0 var(--space-2);
	}

	.intro :global(p:last-child) {
		margin-bottom: 0;
	}

	.components {
		display: grid;
		gap: var(--space-3);
		margin: var(--space-4) 0 0;
		padding: 0;
		list-style: none;
	}

	.components li {
		padding: var(--space-3) var(--space-4);
		background: var(--surface);
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease,
			border-color 0.18s ease;
	}

	.components li:hover {
		transform: translateY(-3px);
		border-color: var(--accent-bright);
		box-shadow: var(--shadow-lift);
	}

	h3 {
		margin: 0 0 var(--space-1);
		font-size: var(--text-base);
	}

	.components p {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--muted);
	}

	/* The icon row: one line whatever it holds, so a card with three links and one with only a star
	   count line up across the grid. The count takes the description's size and colour from the
	   `.components p` rule above. */
	.links {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.links a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		/* Lifts the 20px icons to a 24px target without moving anything around them. */
		padding: 2px 0;
		/* The icons sit at the weight of the description they follow; the name stays the one green
		   target on the card until a pointer or focus reaches an icon. */
		color: var(--muted);
		text-decoration: none;
	}

	.links a:hover,
	.links a:focus-visible {
		color: var(--accent);
	}

	/* Read by screen readers, never shown: the icons alone name these links on screen. */
	.label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (min-width: 720px) {
		section {
			padding-top: var(--space-6);
		}

		.components {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-3);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.components li {
			transition: none;
		}

		.components li:hover {
			transform: none;
		}
	}
</style>
