---
import { render } from 'astro:content';
import type { Site } from '../lib/content';
import SectionIcon from './graphics/SectionIcon.astro';

/** One stack section: a frog icon and title, an intro paragraph, and a card per component. */
interface Props {
	section: Site['sections'][number];
	repoLabel: string;
}

const { section, repoLabel } = Astro.props;
const { Content } = await render(section.intro);
---

<section id={section.id}>
	<h2>
		<SectionIcon name={section.id} />
		<span>{section.title}</span>
	</h2>
	<div class="intro"><Content /></div>
	<ul class="components">
		{
			section.components.map((component) => (
				<li class="panel">
					<h3 id={component.id}>
						<a href={component.url}>{component.name}</a>
					</h3>
					<p>{component.description}</p>
					{component.repo && component.repo !== component.url && (
						<p class="repo">
							<a href={component.repo}>{repoLabel}</a>
						</p>
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	section {
		padding-top: var(--space-5);
	}

	h2 {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin: 0 0 var(--space-3);
		font-size: var(--text-xl);
	}

	/* The whole intro block starts where the heading text does, past the icon column, so the rule
	   sits on the text edge instead of floating an icon's width away from it. */
	.intro {
		position: relative;
		color: var(--muted);
		margin-left: calc(var(--icon) + var(--space-3));
		padding-left: var(--space-3);
	}

	/* The bright-green rule, drawn as a rounded bar rather than a border: a pill radius on a
	   left border alone bows the edge into a crescent. */
	.intro::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: var(--rule);
		border-radius: var(--radius-pill);
		background: var(--accent-bright);
	}

	/* An intro of two paragraphs keeps the same rhythm as a one-paragraph one. `:global`, because
	   the paragraphs come from <Content /> and carry no scope attribute. */
	.intro :global(p) {
		margin: 0 0 var(--space-2);
	}

	.intro :global(p:last-child) {
		margin-bottom: 0;
	}

	.components {
		display: grid;
		gap: var(--space-3);
		margin: var(--space-4) 0 0;
		padding: 0;
		list-style: none;
	}

	.components li {
		padding: var(--space-3) var(--space-4);
		background: var(--surface);
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease,
			border-color 0.18s ease;
	}

	.components li:hover {
		transform: translateY(-3px);
		border-color: var(--accent-bright);
		box-shadow: var(--shadow-lift);
	}

	h3 {
		margin: 0 0 var(--space-1);
		font-size: var(--text-base);
	}

	.components p {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--muted);
	}

	.repo {
		margin-top: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 600;
	}

	@media (min-width: 720px) {
		section {
			padding-top: var(--space-6);
		}

		.components {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-3);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.components li {
			transition: none;
		}

		.components li:hover {
			transform: none;
		}
	}
</style>
