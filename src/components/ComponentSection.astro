---
import { render } from 'astro:content';
import type { Site } from '../lib/content';

/** One stack section: title, intro paragraph, and a card per component. */
interface Props {
	section: Site['sections'][number];
	repoLabel: string;
}

const { section, repoLabel } = Astro.props;
const { Content } = await render(section.intro);
---

<section id={section.id}>
	<h2>{section.title}</h2>
	<div class="intro"><Content /></div>
	<ul class="components">
		{
			section.components.map((component) => (
				<li>
					<h3 id={component.id}>
						<a href={component.url}>{component.name}</a>
					</h3>
					<p>{component.description}</p>
					{component.repo && component.repo !== component.url && (
						<p class="repo">
							<a href={component.repo}>{repoLabel}</a>
						</p>
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	section {
		padding-top: var(--space-5);
	}

	h2 {
		margin: 0 0 var(--space-2);
		font-size: var(--text-xl);
	}

	/* The page motif: an accent rule, here marking the start of a section. */
	h2::before {
		content: '';
		display: block;
		width: var(--rule);
		height: var(--rule-width);
		margin-bottom: var(--space-2);
		background: var(--accent);
	}

	.intro {
		color: var(--muted);
	}

	/* An intro of two paragraphs keeps the same rhythm as a one-paragraph one. `:global`, because
	   the paragraphs come from <Content /> and carry no scope attribute. */
	.intro :global(p) {
		margin: 0 0 var(--space-2);
	}

	.intro :global(p:last-child) {
		margin-bottom: 0;
	}

	.components {
		display: grid;
		gap: var(--space-4);
		margin: var(--space-4) 0 0;
		padding: 0;
		list-style: none;
	}

	h3 {
		margin: 0 0 var(--space-1);
		font-size: var(--text-base);
	}

	.components p {
		margin: 0;
	}

	.repo {
		margin-top: var(--space-1);
		font-size: var(--text-sm);
	}

	@media (min-width: 720px) {
		.components {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
