---
import Base from '../layouts/Base.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import ComponentSection from '../components/ComponentSection.astro';
import FloatingNav from '../components/FloatingNav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import AgentPrompt from '../components/AgentPrompt.astro';
import Promo from '../components/Promo.astro';
import SnippetSwitcher from '../components/SnippetSwitcher.astro';
import Divider from '../components/graphics/Divider.astro';
import { pageUrl } from '../lib/base';
import { loadSite } from '../lib/content';
import { snippetRegion } from '../lib/snippets';

const { hero, agentPrompt, sections, promos, footer, labels, snippets, benefits } =
	await loadSite();

const tabs = snippets.map((snippet) => ({
	id: snippet.id,
	label: snippet.label,
	code: snippetRegion(snippet.file),
	fullExampleHref: `${footer.repoUrl}/blob/main/${snippet.file}`,
}));

// Structured data for crawlers, built from the collections the page itself renders: the stack as an
// ordered list, each item pointing at the card's anchor. Nothing here is written twice.
const canonical = pageUrl(Astro.site);
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			name: hero.title,
			alternateName: hero.acronym,
			url: canonical,
			description: hero.tagline,
			inLanguage: 'en',
		},
		{
			'@type': 'ItemList',
			itemListElement: sections
				.flatMap((section) => section.components)
				.map((component, index) => ({
					'@type': 'ListItem',
					position: index + 1,
					name: component.name,
					url: `${canonical}#${component.id}`,
				})),
		},
	],
};
---

<Base
	title={`${hero.title} (${hero.acronym})`}
	description={hero.tagline}
	siteName={hero.title}
	imageAlt={labels.shareImageAlt}
	skipLabel={labels.skipLink}
	jsonLd={jsonLd}
>
	{/* First in the body after the skip link, so a reader tabbing forward reaches the picker before
	    the content it jumps into — and only while it is on screen, since it is display: none until
	    the script shows it. */}
	<FloatingNav
		sections={sections}
		homeLabel={labels.chapterHome}
		snippetsLabel={labels.chapterSnippets}
		promptLabel={labels.chapterPrompt}
		benefitsLabel={labels.chapterBenefits}
		label={labels.chapterPicker}
		menuLabel={labels.chapterMenu}
	/>
	{/* Four chapters, each opened by its own heading: the snippets show the code, the prompt chapter
	    hands over the agent prompt, the benefits make the argument, and the components chapter lists
	    the stack. A sprig closes the hero and another closes the benefits, leading straight into the
	    components chapter; the snippets need none, because the band's top edge is already a line
	    across the page. The band paints its own ground, which is why it sits outside `.page` — the
	    only block that runs to the window's edges. */}
	<main id="content">
		<div class="page">
			<Hero hero={hero} labels={labels} />
			<Divider />
			<SnippetSwitcher
				tabs={tabs}
				fullExampleLabel={labels.fullExample}
				legend={labels.snippetsLegend}
				heading={labels.snippetsHeading}
				note={labels.snippetsNote}
			/>
			{promos.afterSnippets.map((promo) => <Promo promo={promo} />)}
			{/* After the VirtusLab promo: the code, who maintains it, then how to start. */}
			<AgentPrompt prompt={agentPrompt} />
		</div>
		<BenefitsSection benefits={benefits} promos={promos.afterBenefits} />
		<div class="page">
			<Divider />
			{sections.map((section) => <ComponentSection section={section} labels={labels} />)}
			{/* The wrapper holds `#commercial`, the anchor from when this was a single block; each
			    block inside answers to its own `#promo-<id>`. */}
			<section id="commercial">
				{promos.afterComponents.map((promo) => <Promo promo={promo} />)}
			</section>
		</div>
	</main>
	<div class="page">
		<Footer footer={footer} labels={labels} />
	</div>
	{/*
		The page's only JavaScript, in three parts. First, star counts, refreshed when a card scrolls into
		view and cached for an hour. Everything else works without it, and so does this — a build with a
		GITHUB_TOKEN bakes the counts into the HTML, and a card with no count at all still links to the
		repository, where the star button is. Second, the current-chapter mark in the floating picker,
		and closing its phone panel on a jump; without the script the picker is still there, only with
		no pill filled and the panel left open until tapped shut. Third, the copy button on
		the agent prompt, shown only where there is a clipboard to write to; without it the prompt is
		still there to select.
	*/}
	<script is:inline>
		(() => {
			if (!('IntersectionObserver' in window)) return;
			const hour = 60 * 60 * 1000;
			const key = (repo) => `stars:${repo}`;
			// Same rule as `formatStars` in src/lib/content.ts, which bakes the initial text.
			const format = (count) =>
				count > 999 ? `${(count / 1000).toFixed(1).replace(/\.0$/, '')}k` : `${count}`;

			const cached = (repo) => {
				try {
					const { count, at } = JSON.parse(localStorage.getItem(key(repo)));
					return typeof count === 'number' && Date.now() - at < hour ? count : null;
				} catch {
					return null;
				}
			};

			const show = async (span) => {
				const repo = span.dataset.stars;
				const known = cached(repo);
				if (known !== null) return void (span.textContent = format(known));
				const [owner, name] = repo.split('/').map(encodeURIComponent);
				try {
					const response = await fetch(`https://api.github.com/repos/${owner}/${name}`, {
						headers: { Accept: 'application/vnd.github+json' },
					});
					if (!response.ok) return;
					const { stargazers_count: count } = await response.json();
					if (typeof count !== 'number') return;
					span.textContent = format(count);
					localStorage.setItem(key(repo), JSON.stringify({ count, at: Date.now() }));
				} catch {}
			};

			// The links are observed, not the counts: an empty span has no box to intersect with.
			const observer = new IntersectionObserver((entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer.unobserve(entry.target);
					show(entry.target.querySelector('[data-stars]'));
				}
			});
			document.querySelectorAll('a.stars').forEach((link) => observer.observe(link));
		})();

		(() => {
			const bar = document.querySelector('[data-float-nav]');
			if (!bar) return;

			// The home pill is left out: it jumps to the top, which is no chapter, and must never fill.
			const links = [...bar.querySelectorAll('a:not([data-home])')];
			const targets = links.map((link) => document.getElementById(link.hash.slice(1)));

			// On a phone the links sit in a panel behind a hamburger, which a followed anchor would
			// otherwise leave open over the chapter just jumped to.
			const toggle = document.getElementById('picker-open');
			links.forEach((link) => link.addEventListener('click', () => (toggle.checked = false)));

			const show = (current) => {
				for (const link of links) {
					if (link === current) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				}
			};

			// The chapter the reader is in is the last one starting above a line 40% down the viewport:
			// the block holding the top of the screen, and at the page's end the final section.
			const mark = () => {
				const line = window.innerHeight * 0.4;
				let current;
				targets.forEach((target, i) => {
					if (target && target.getBoundingClientRect().top <= line) current = links[i];
				});
				show(current);
			};

			// A followed anchor names its own chapter, so it is marked on the spot rather than measured:
			// on a tall viewport the block jumped to can come to rest below the line — the page having
			// no more room to scroll — which would leave the entry above it lit. The next scroll, if
			// there is one, measures again.
			const fromHash = () => {
				const entry = links.find((link) => link.hash === location.hash);
				if (entry) show(entry);
			};
			addEventListener('hashchange', fromHash);

			// Measured on scroll, not watched with an IntersectionObserver: a jump between two positions
			// that both leave the line bare — an anchor, the page's end — crosses nothing to report.
			let queued = false;
			const schedule = () => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(() => {
					queued = false;
					mark();
				});
			};
			addEventListener('scroll', schedule, { passive: true });
			addEventListener('resize', schedule, { passive: true });
			mark();
			fromHash();
		})();

		(() => {
			const button = document.querySelector('[data-copy]');
			if (!button || !navigator.clipboard) return;
			const text = button.parentElement.querySelector('pre');
			const idle = button.textContent;
			button.hidden = false;
			let timer;
			button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(text.textContent);
				} catch {
					// Nothing to report: the text is right there to select.
					return;
				}
				button.textContent = button.dataset.copiedLabel;
				clearTimeout(timer);
				timer = setTimeout(() => (button.textContent = idle), 2000);
			});
		})();
	</script>
</Base>

<style>
	.page {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0 var(--space-3);
	}
</style>
