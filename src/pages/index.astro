---
import Base from '../layouts/Base.astro';
import Commercial from '../components/Commercial.astro';
import ComponentSection from '../components/ComponentSection.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.astro';
import SnippetSwitcher from '../components/SnippetSwitcher.astro';
import { loadSite } from '../lib/content';
import { snippetRegion } from '../lib/snippets';

const { hero, sections, commercial, visdom, footer, labels, snippets } = await loadSite();

const tabs = snippets.map((snippet) => ({
	id: snippet.id,
	label: snippet.label,
	code: snippetRegion(snippet.file),
	componentId: snippet.component.id,
	componentName: snippet.component.name,
	fullExampleHref: `${footer.repoUrl}/blob/main/${snippet.file}`,
}));
---

<Base title={hero.title} description={hero.tagline}>
	<div class="page">
		<main>
			<Hero hero={hero} labels={labels} />
			{/* The nav sits between the hero and the switcher, so the first screen is hero + code. */}
			<Nav sections={sections} repoLabel={footer.repoLabel} repoUrl={footer.repoUrl} />
			<SnippetSwitcher
				tabs={tabs}
				fullExampleLabel={labels.fullExample}
				legend={labels.snippetsLegend}
			/>
			{sections.map((section) => <ComponentSection section={section} repoLabel={labels.repo} />)}
			<Commercial commercial={commercial} visdom={visdom} />
		</main>
		<Footer footer={footer} labels={labels} />
	</div>
</Base>

<style>
	.page {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0 var(--space-3);
	}
</style>
